<!-- SPDX-License-Identifier: MIT -->
<rml>
<head>
	<title>MEVR settings</title>
	<link type="text/rcss" href="main.rcss"/>
</head>
<!--
	MEVR's VR main menu (research/28), after the approved "glass" board. Every value is bound to the data model
	"menu" (plugin/menu/MenuModel: toggle('key'), pick('key', 'value'), cmd('name', 'arg'), sliders by data-value);
	what each key drives is in plugin/MainMenuSettings.cpp. Rows marked "soon" show what's planned and do nothing yet.
	Edit while the game runs: the menu reloads this file within a second of a save.
-->
<body data-model="menu">

<div class="top">
	<div class="brand">
		<div class="logo"/>
		<div><div class="brandName">MEVR</div><div class="brandSub">Settings</div></div>
	</div>
	<div class="topspace"/>
	<!-- The game's own menus: the way into them (no controller menu button can be counted on, e.g. a Quest over Link). -->
	<div class="gamebtns">
		<button class="btn game" id="game-menu" data-event-click="cmd('game_menu')"><div class="sweep"/><div class="bi i-gamemenu"/><div class="gl"><span class="gt">Game menu</span><span class="gs">Save, load, squad, map, options</span></div></button>
		<button class="btn game" id="game-back" data-event-click="cmd('game_back')"><div class="sweep"/><div class="bi i-holster"/><div class="gl"><span class="gt">Holster</span><span class="gs">Puts the drawn gun away</span></div></button>
	</div>
	<button class="btn primary" id="resume" data-event-click="cmd('resume')"><div class="sweep"/><div class="bi i-play"/><span>Resume</span></button>
</div>

<div class="main">
	<div class="rail">
		<button class="navb" id="nav-guide" data-class-on="section == 'guide'" data-event-click="section = 'guide'"><div class="nico i-guide"/><div><div class="navl">Controller guide</div><div class="navs">Every button and gesture</div></div></button>
		<button class="navb" id="nav-comfort" data-class-on="section == 'comfort'" data-event-click="section = 'comfort'"><div class="nico i-turn"/><div><div class="navl">Comfort</div><div class="navs">Turning, movement</div></div></button>
		<button class="navb" id="nav-controls" data-class-on="section == 'controls'" data-event-click="section = 'controls'"><div class="nico i-controls"/><div><div class="navl">Controls</div><div class="navs">Guns, holsters, grenades</div></div></button>
		<button class="navb" id="nav-voice" data-class-on="section == 'voice'" data-event-click="section = 'voice'"><div class="nico i-mic"/><div><div class="navl">Voice</div><div class="navs">Microphone, squad orders</div></div></button>
		<button class="navb" id="nav-body" data-class-on="section == 'body'" data-event-click="section = 'body'"><div class="nico i-body"/><div><div class="navl">Body &amp; calibration</div><div class="navs">Height, arms, aim</div></div></button>
		<button class="navb" id="nav-display" data-class-on="section == 'display'" data-event-click="section = 'display'"><div class="nico i-eye"/><div><div class="navl">Display</div><div class="navs">Colour, resolution</div></div></button>
		<button class="navb" id="nav-hud" data-class-on="section == 'hud'" data-event-click="section = 'hud'"><div class="nico i-crosshair"/><div><div class="navl">HUD &amp; sights</div><div class="navs">Panel, reticle, scopes</div></div></button>
		<button class="navb" id="nav-advanced" data-class-on="section == 'advanced'" data-event-click="section = 'advanced'"><div class="nico i-sliders"/><div><div class="navl">Advanced</div><div class="navs">View, stereo, diagnostics</div></div></button>
		<div class="railspace"/>
		<!-- The headset, controllers and calibration (in the top bar until the game's menus took its room). -->
		<div class="chips">
			<div class="chip"><div class="ico i-headset"/><span>{{chip_headset}}</span></div>
			<div class="chip"><div class="ico i-controller"/><span>{{chip_controllers}}</span></div>
			<div class="chip" data-class-ok="calibrated"><div class="ico i-check"/><span>{{chip_calibrated}}</span></div>
		</div>
		<!-- A failed write of the settings file (a read-only ASI folder): nothing the menu changes is kept. -->
		<div class="note" data-if="save_msg != ''">{{save_msg}}</div>
	</div>

	<div class="content" id="content">

	<!-- The game crashed last session (crash-breadcrumbs.txt newer than the last report and the last "no"). -->
	<div class="group crashoffer" data-if="crash_offer">
		<div class="row"><div class="rl"><div class="rlab">The game crashed last session</div><div class="rdesc">Create a report? MEVR Setup gathers the logs and the crash details into a zip on your Desktop, in the background. Nothing is sent.</div></div>
			<div class="actions">
				<button class="btn" data-event-click="cmd('crash_dismiss')"><div class="sweep"/><span>No thanks</span><div class="tick"/></button>
				<button class="btn primary" data-event-click="cmd('report')"><div class="sweep"/><div class="bi i-report"/><span>Create a report</span></button>
			</div></div>
	</div>

	<!-- ===================================================================================== Controller guide -->
	<!-- What each control does (research/28 "The controller guide"). The labels and the list come from the settings
	     (core/vr/MenuSettings GuideTexts); the drawing is RCSS boxes (.gdraw), no artwork. The first opening for a new
	     player lands here (MainMenu's first run, [Menu] controlsShown). -->
	<div data-if="section == 'guide'">
		<div class="stitle">Controller guide</div>
		<div class="sdesc">What each button and gesture does on foot. Open this menu any time: press and hold both thumbsticks.</div>
		<div class="info welcome" data-if="first_run"><div class="ico i-info"/><span>Welcome to MEVR. This guide stays here, first in the list on the left. Resume when you're ready; Body &amp; calibration fits Shepard to your height and aim.</span></div>
		<div class="guide">
			<div class="gcard">
				<div class="gname">Left controller</div>
				<div class="gdraw">
					<div class="gtrig"/><div class="gbody"/><div class="gstick"><div class="gknob"/></div>
					<div class="gbtn up">Y</div><div class="gbtn lo">X</div><div class="gmenu"/><div class="ggrip onright"/>
					<div class="glead l t"/><div class="glab l t"><div>{{guide_lt}}</div></div>
					<div class="glead l s"/><div class="glab l s"><div>{{guide_lstick}}</div></div>
					<div class="glead l up"/><div class="glab l up"><div>{{guide_y}}</div></div>
					<div class="glead l lo"/><div class="glab l lo"><div>{{guide_x}}</div></div>
					<div class="glead l m"/><div class="glab l m"><div>{{guide_menu}}</div></div>
					<div class="glead r g"/><div class="glab r g"><div>{{guide_lgrip}}</div></div>
				</div>
				<div class="glist">
					<div class="gitem"><span class="key">Trigger</span><div class="gdesc">{{guide_lt_how}}</div></div>
					<div class="gitem"><span class="key">Grip</span><div class="gdesc">{{guide_lgrip_how}}</div></div>
					<div class="gitem"><span class="key">Stick</span><div class="gdesc">{{guide_lstick_how}}</div></div>
					<div class="gitem"><span class="key">X</span><div class="gdesc">{{guide_x_how}}</div></div>
					<div class="gitem"><span class="key">Y</span><div class="gdesc">{{guide_y_how}}</div></div>
					<div class="gitem"><span class="key">Menu</span><div class="gdesc">{{guide_menu_how}}</div></div>
				</div>
			</div>
			<div class="gcard">
				<div class="gname">Right controller</div>
				<div class="gdraw">
					<div class="gtrig"/><div class="gbody"/><div class="gstick"><div class="gknob"/></div>
					<div class="gbtn up">B</div><div class="gbtn lo">A</div><div class="ggrip onleft"/>
					<div class="glead r t"/><div class="glab r t"><div>{{guide_rt}}</div></div>
					<div class="glead r s"/><div class="glab r s"><div>{{guide_rstick}}</div></div>
					<div class="glead r up"/><div class="glab r up"><div>{{guide_b}}</div></div>
					<div class="glead r lo"/><div class="glab r lo"><div>{{guide_a}}</div></div>
					<div class="glead l g"/><div class="glab l g"><div>{{guide_rgrip}}</div></div>
				</div>
				<div class="glist">
					<div class="gitem"><span class="key">Trigger</span><div class="gdesc">{{guide_rt_how}}</div></div>
					<div class="gitem"><span class="key">Grip</span><div class="gdesc">{{guide_rgrip_how}}</div></div>
					<div class="gitem"><span class="key">Stick</span><div class="gdesc">{{guide_rstick_how}}</div></div>
					<div class="gitem"><span class="key">A</span><div class="gdesc">{{guide_a_how}}</div></div>
					<div class="gitem"><span class="key">B</span><div class="gdesc">{{guide_b_how}}</div></div>
				</div>
			</div>
		</div>
		<div class="info"><div class="ico i-info"/><span>Buttons named as on Quest controllers: A and X are the lower face buttons, B and Y the upper ones.</span></div>
		<div class="group">
			<div class="gtitle"><span>Gestures</span><div class="gline"/></div>
			<div class="row" data-if="holsters"><div class="rl"><div class="rlab">Holsters</div><div class="rdesc">Reach with your right hand and squeeze the grip: the pistol at your right hip, the assault rifle over your right shoulder, the shotgun at your left hip, the sniper rifle over your left shoulder.</div></div></div>
			<div class="row"><div class="rl"><div class="rlab">Grenades</div><div class="rdesc">{{guide_grenade}}</div></div></div>
			<div class="row"><div class="rl"><div class="rlab">Melee</div><div class="rdesc">{{guide_melee}}</div></div></div>
			<div class="row"><div class="rl"><div class="rlab">Both hands on the gun</div><div class="rdesc">Squeeze the left grip with your left hand on the gun. Raise it to your cheek for aimed fire.</div></div></div>
			<div class="row" data-if="vent"><div class="rl"><div class="rlab">Vent a hot gun</div><div class="rdesc">When the gun runs hot, squeeze the left grip on its top just ahead of your right hand, then pull back fast as you let go.</div></div></div>
			<div class="row" data-if="crouch"><div class="rl"><div class="rlab">Crouch</div><div class="rdesc">Crouch for real and Shepard crouches with you, down behind low cover.</div></div></div>
			<div class="row"><div class="rl"><div class="rlab">This menu, recenter</div><div class="rdesc">Press and hold both thumbsticks for this menu. Double-click the right thumbstick to turn the view to face where you look.</div></div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Powers</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Pick a power</div><div class="rdesc">{{guide_pick}}</div></div></div>
			<div class="row"><div class="rl"><div class="rlab">Cast it</div><div class="rdesc">{{guide_cast}}</div></div></div>
			<div class="row"><div class="rl"><div class="rlab">Powers on yourself</div><div class="rdesc">{{guide_self}}</div></div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>In the Mako</span><div class="gline"/></div>
			<div data-if="mako_controls">
				<div class="row"><div class="rl"><div class="rlab">Throttle lever, left hand</div><div class="rdesc">Squeeze the grip at the lever by your left side. Push it forward to drive, pull it back to reverse; it stays where you leave it. X: jump jets (and back onto the wheels), Y: boost.</div></div></div>
				<div class="row"><div class="rl"><div class="rlab">Drive stick, right hand</div><div class="rdesc">Squeeze the grip at the stick by your right side. Tilt it left and right to steer, forward and back to pitch while the jets fire. Trigger: machine gun, A: cannon, thumbstick: turret.</div></div></div>
				<div class="row"><div class="rl"><div class="rlab">Before you grab them</div><div class="rdesc">Point the right controller to aim. The game's own controls work: the left stick drives, the right trigger fires the machine gun, the right grip the cannon.</div></div></div>
			</div>
			<div class="row" data-if="!mako_controls"><div class="rl"><div class="rlab">The game's controls</div><div class="rdesc">Point the right controller to aim. The left stick drives, the right trigger fires the machine gun, the right grip the cannon, A jumps.</div></div></div>
			<div class="row"><div class="rl"><div class="rlab">Getting out</div><div class="rdesc">B leaves the Mako.</div></div></div>
		</div>
	</div>

	<!-- ===================================================================================== Comfort -->
	<div data-if="section == 'comfort'">
		<div class="stitle">Comfort</div>
		<div class="sdesc">How you turn and move.</div>
		<div class="group">
			<div class="gtitle"><span>Turning</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Turn style</div><div class="rdesc">Snap jumps by an angle per flick of the right stick; smooth is the game's own turn while you hold it</div></div>
				<div class="seg"><button class="segb" data-class-on="turn == 'snap'" data-event-click="pick('turn','snap')">Snap</button><button class="segb" data-class-on="turn == 'smooth'" data-event-click="pick('turn','smooth')">Smooth</button></div></div>
			<div class="row" data-class-disabled="turn != 'snap'"><div class="rl"><div class="rlab">Snap angle</div><div class="rdesc">How far one flick turns you</div></div>
				<div class="seg"><button class="segb" data-class-on="snap == '30'" data-event-click="pick('snap','30')">30°</button><button class="segb" data-class-on="snap == '45'" data-event-click="pick('snap','45')">45°</button><button class="segb" data-class-on="snap == '60'" data-event-click="pick('snap','60')">60°</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Comfort vignette</div><div class="rdesc">Darkens the edges of your view while the stick turns you</div></div>
				<button class="tog" data-class-on="vignette" data-event-click="toggle('vignette')"><div class="knob"/></button></div>
			<div class="row" data-class-disabled="!vignette"><div class="rl"><div class="rlab">Vignette when</div><div class="rdesc">Only while turning, or while the left stick walks you too</div></div>
				<div class="seg"><button class="segb" data-class-on="vignette_when == 'turn'" data-event-click="pick('vignette_when','turn')">Turning</button><button class="segb" data-class-on="vignette_when == 'move'" data-event-click="pick('vignette_when','move')">Turning and moving</button></div></div>
			<div class="srow" data-class-disabled="!vignette"><div class="slab">Vignette strength</div><input type="range" min="10" max="100" step="5" data-value="vignette_strength"/><div class="sval">{{vignette_strength_text}}</div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Movement</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Walk toward</div><div class="rdesc">What the left stick's forward means: where you look, or where your left hand points.</div></div>
				<div class="seg"><button class="segb" data-class-on="walk == 'head'" data-event-click="pick('walk','head')">Where I look</button><button class="segb" data-class-on="walk == 'hand'" data-event-click="pick('walk','hand')">Left hand</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Physical crouch</div><div class="rdesc">Crouch for real and Shepard crouches with you</div></div>
				<button class="tog" data-class-on="crouch" data-event-click="toggle('crouch')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Conversations and cutscenes</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Conversations</div><div class="rdesc">In VR the director's camera moves you around; the 3D screen shows its shots on a big screen with depth; the flat screen without.</div></div>
				<div class="seg"><button class="segb" data-class-on="cine_convo == 'vr'" data-event-click="pick('cine_convo','vr')">In VR</button><button class="segb" data-class-on="cine_convo == 'screen'" data-event-click="pick('cine_convo','screen')">3D screen</button><button class="segb" data-class-on="cine_convo == 'flat'" data-event-click="pick('cine_convo','flat')">Flat screen</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Cutscenes</div><div class="rdesc">The same choice for cutscenes.</div></div>
				<div class="seg"><button class="segb" data-class-on="cine_cut == 'vr'" data-event-click="pick('cine_cut','vr')">In VR</button><button class="segb" data-class-on="cine_cut == 'screen'" data-event-click="pick('cine_cut','screen')">3D screen</button><button class="segb" data-class-on="cine_cut == 'flat'" data-event-click="pick('cine_cut','flat')">Flat screen</button></div></div>
			<div class="srow" data-class-disabled="!(cine_convo == 'screen' || cine_cut == 'screen')"><div class="slab">Screen width</div><input type="range" min="1.5" max="8" step="0.1" data-value="cine_width"/><div class="sval">{{cine_width_text}}</div></div>
			<div class="srow" data-class-disabled="!(cine_convo == 'screen' || cine_cut == 'screen')"><div class="slab">Screen distance</div><input type="range" min="1" max="6" step="0.1" data-value="cine_distance"/><div class="sval">{{cine_distance_text}}</div></div>
			<div class="srow" data-class-disabled="!(cine_convo == 'screen' || cine_cut == 'screen')"><div class="slab">3D depth</div><input type="range" min="0" max="150" step="5" data-value="cine_depth"/><div class="sval">{{cine_depth_text}}</div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Game screens</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Game screens in the room</div><div class="rdesc">Shops, loot, the journal, the map and the game's other full-screen menus stand in the room where they open; point at them to use them. Off: on a flat screen with the world gone.</div></div>
				<button class="tog" data-class-on="world_ui" data-event-click="toggle('world_ui')"><div class="knob"/></button></div>
			<div class="row" data-class-disabled="!world_ui"><div class="rl"><div class="rlab">Omni-tool screens</div><div class="rdesc">Your equipment, squad, journal, codex, map, the game menu and the hacking screen: projected from your left wrist, with a menu beside them to switch (tap your left wrist to open it), or standing in the room</div></div>
				<div class="seg"><button class="segb" data-class-on="wrist_screen == 'wrist'" data-event-click="pick('wrist_screen','wrist')">On my wrist</button><button class="segb" data-class-on="wrist_screen == 'room'" data-event-click="pick('wrist_screen','room')">In the room</button></div></div>
			<div class="srow" data-class-disabled="!world_ui || wrist_screen != 'wrist'"><div class="slab">Wrist screen size</div><input type="range" min="0.4" max="1" step="0.05" data-value="wrist_width"/><div class="sval">{{wrist_width_text}}</div></div>
			<div class="row"><div class="rl"><div class="rlab">Galaxy map hologram</div><div class="rdesc">On the Normandy the galaxy map stands as a hologram over the CIC's projector: walk up and point to pick a destination. Off: the game's flat map.</div></div>
				<button class="tog" data-class-on="galaxy_holo" data-event-click="toggle('galaxy_holo')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>This menu</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Pause while open</div><div class="rdesc">The game waits while you change settings</div></div>
				<button class="tog" data-class-on="pause" data-event-click="toggle('pause')"><div class="knob"/></button></div>
		</div>
	</div>

	<!-- ===================================================================================== Controls -->
	<div data-if="section == 'controls'">
		<div class="stitle">Controls</div>
		<div class="sdesc">Your hands are Shepard's hands.</div>
		<div class="group">
			<div class="gtitle"><span>Weapons</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Grip holds the gun</div><div class="rdesc">Squeeze to carry it; let go at its holster to put it away</div></div>
				<button class="tog" data-class-on="grip_holds" data-event-click="toggle('grip_holds')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Body holsters</div><div class="rdesc">Pistol at the right hip, assault rifle over the right shoulder, shotgun at the left hip, sniper rifle over the left shoulder</div></div>
				<button class="tog" data-class-on="holsters" data-event-click="toggle('holsters')"><div class="knob"/></button></div>
			<div class="srow"><div class="slab">Holster buzz</div><input type="range" min="0" max="100" step="5" data-value="holster_buzz"/><div class="sval">{{holster_buzz_text}}</div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Hands</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Left trigger</div><div class="rdesc">Weapon wheel: pull to open it at your left hand, point at a squadmate to arm them, let go to choose. Aim: the game's aim button. Off: nothing. Aimed fire also comes from holding the gun at your cheek with both hands.</div></div>
				<div class="seg"><button class="segb" data-class-on="left_trigger == 'lb'" data-event-click="pick('left_trigger','lb')">Weapon wheel</button><button class="segb" data-class-on="left_trigger == 'lt'" data-event-click="pick('left_trigger','lt')">Aim</button><button class="segb" data-class-on="left_trigger == 'none'" data-event-click="pick('left_trigger','none')">Off</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Fingers follow yours</div><div class="rdesc">Shepard's index finger curls with your trigger and the other fingers with your grip</div></div>
				<button class="tog" data-class-on="fingers" data-event-click="toggle('fingers')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Combat</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Physical grenades and melee</div><div class="rdesc">{{guide_grenade}} Strike fast at an enemy to melee.</div><div class="note" data-if="throwables_note != ''">{{throwables_note}}</div></div>
				<button class="tog" data-class-on="throwables" data-event-click="toggle('throwables')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Vent by racking the gun</div><div class="rdesc">When the gun runs hot, squeeze the left grip on its top just ahead of your right hand and pull back fast: the heat is gone at once (a change to the game's rules)</div></div>
				<button class="tog" data-class-on="vent" data-event-click="toggle('vent')"><div class="knob"/></button></div>
			<div class="srow"><div class="slab">Recoil buzz</div><input type="range" min="0" max="100" step="5" data-value="recoil_buzz"/><div class="sval">{{recoil_buzz_text}}</div></div>
			<div class="row"><div class="rl"><div class="rlab">Aim assist</div><div class="rdesc">Off: the stick turns you at the speed you ask, even near enemies</div></div>
				<button class="tog" data-class-on="aim_assist" data-event-click="toggle('aim_assist')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Weapon drawn</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Steady view</div><div class="rdesc">Drawing, holstering, aiming and sprinting leave your eyes where they are</div></div>
				<button class="tog" data-class-on="constant_eye" data-event-click="toggle('constant_eye')"><div class="knob"/></button></div>
			<div class="srow"><div class="slab">Draw speed</div><input type="range" min="1" max="10" step="0.5" data-value="draw_rate"/><div class="sval">{{draw_rate_text}}</div></div>
			<div class="row"><div class="rl"><div class="rlab">Gun kicks when you fire</div><div class="rdesc">The gun jumps up and back in your hand on each shot, harder for a shotgun or a sniper rifle, less with both hands on it. Your aim and the shots stay where you point.</div></div>
				<button class="tog" data-class-on="gun_kick" data-event-click="toggle('gun_kick')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Mako</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Throttle lever and drive stick</div><div class="rdesc">Drive with a lever by your left side and a stick by your right: grab them with the grips (the Controller guide has the details). Off: the game's own Mako controls.</div></div>
				<button class="tog" data-class-on="mako_controls" data-event-click="toggle('mako_controls')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Sit in the cockpit</div><div class="rdesc">In the Mako you sit in its cockpit, the outside view on the screen ahead. Off: the game's camera behind the Mako.</div></div>
				<button class="tog" data-class-on="cockpit" data-event-click="toggle('cockpit')"><div class="knob"/></button></div>
		</div>
	</div>

	<!-- ===================================================================================== Voice -->
	<!-- Voice orders (research/54 "The menu's Voice page"): the microphone, its level, the recognizer (the host's plugin/Voice,
	     restarted on a change of microphone, model or the switch), and [Voice]'s other keys. -->
	<div data-if="section == 'voice'">
		<div class="stitle">Voice</div>
		<div class="sdesc">Talk to your squad: hold the left grip at your left ear like a radio, speak, let go.</div>
		<div class="group">
			<div class="gtitle"><span>Microphone</span><div class="gline"/></div>
			<div class="srow meterrow"><div class="sl"><div class="slab">Input level</div><div class="rdesc" data-if="!voice_heard">Speak to test</div><div class="rdesc heard" data-if="voice_heard">Hearing you</div></div>
				<div class="meter"><div class="fill" data-class-hot="voice_heard" data-style-width="voice_level + '%'"/><div class="mark"/></div></div>
			<div class="info" data-class-warn="!voice_ready"><div class="ico i-info"/><span>{{voice_status}}</span></div>
			<button class="row mic" data-class-on="mic == 'default'" data-event-click="pick('mic','default')"><div class="radio"/><div class="rl"><div class="rlab">Default</div><div class="rdesc">{{mic_default}}</div></div></button>
			<button class="row mic" data-if="mic_count > 0" data-class-on="mic == '0'" data-event-click="pick('mic','0')"><div class="radio"/><div class="rl"><div class="rlab">{{mic0}}</div></div></button>
			<button class="row mic" data-if="mic_count > 1" data-class-on="mic == '1'" data-event-click="pick('mic','1')"><div class="radio"/><div class="rl"><div class="rlab">{{mic1}}</div></div></button>
			<button class="row mic" data-if="mic_count > 2" data-class-on="mic == '2'" data-event-click="pick('mic','2')"><div class="radio"/><div class="rl"><div class="rlab">{{mic2}}</div></div></button>
			<button class="row mic" data-if="mic_count > 3" data-class-on="mic == '3'" data-event-click="pick('mic','3')"><div class="radio"/><div class="rl"><div class="rlab">{{mic3}}</div></div></button>
			<button class="row mic" data-if="mic_count > 4" data-class-on="mic == '4'" data-event-click="pick('mic','4')"><div class="radio"/><div class="rl"><div class="rlab">{{mic4}}</div></div></button>
			<button class="row mic" data-if="mic_count > 5" data-class-on="mic == '5'" data-event-click="pick('mic','5')"><div class="radio"/><div class="rl"><div class="rlab">{{mic5}}</div></div></button>
			<button class="row mic" data-if="mic_count > 6" data-class-on="mic == '6'" data-event-click="pick('mic','6')"><div class="radio"/><div class="rl"><div class="rlab">{{mic6}}</div></div></button>
			<button class="row mic" data-if="mic_count > 7" data-class-on="mic == '7'" data-event-click="pick('mic','7')"><div class="radio"/><div class="rl"><div class="rlab">{{mic7}}</div></div></button>
			<div class="row mic on" data-if="mic == 'missing'"><div class="radio"/><div class="rl"><div class="rlab">{{mic_missing}}</div><div class="rdesc">Set in the file but not connected now: the default is used until it is.</div></div></div>
			<div class="note" data-if="mic_note != ''">{{mic_note}}</div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Recognizer</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Voice orders</div><div class="rdesc">Off: the microphone stays closed and the radio gesture does nothing</div></div>
				<button class="tog" data-class-on="voice_on" data-event-click="toggle('voice_on')"><div class="knob"/></button></div>
			<div class="row" data-class-disabled="!voice_on"><div class="rl"><div class="rlab">Recognizer size</div><div class="rdesc">Tiny is the default: it answers fastest beside the running game. Small and medium understand more but each update takes three times as long or more.</div></div>
				<div class="seg"><button class="segb" data-class-on="voice_model == 'tiny'" data-event-click="pick('voice_model','tiny')">Tiny</button><button class="segb" data-class-on="voice_model == 'small'" data-event-click="pick('voice_model','small')">Small</button><button class="segb" data-class-on="voice_model == 'medium'" data-event-click="pick('voice_model','medium')">Medium</button></div></div>
			<div class="row" data-class-disabled="!voice_on"><div class="rl"><div class="rlab">Restart the recognizer</div><div class="rdesc">Opens the microphone again: after plugging in a headset</div></div>
				<button class="btn" data-event-click="cmd('voice_restart')"><div class="sweep"/><span>Restart</span><div class="tick"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Talking</span><div class="gline"/></div>
			<div class="srow d" data-class-disabled="!voice_on"><div class="sl"><div class="slab">Radio hum</div><div class="rdesc">The left controller hums when your hand is at the ear, stronger nearer it. 0%: none.</div></div><input type="range" min="0" max="100" step="5" data-value="ear_cue"/><div class="sval">{{ear_cue_text}}</div></div>
			<div class="row" data-class-disabled="!voice_on"><div class="rl"><div class="rlab">Hold-to-talk key</div><div class="rdesc">A keyboard key held to speak, besides the radio gesture: {{voice_key}}</div></div>
				<div class="actions">
					<button class="btn" data-class-armed="voice_key_wait" data-event-click="cmd('voice_key_set')"><div class="sweep"/><span>Set key</span><div class="tick"/></button>
					<button class="btn" data-event-click="cmd('voice_key_clear')"><div class="sweep"/><span>None</span><div class="tick"/></button>
				</div></div>
		</div>
	</div>

	<!-- ===================================================================================== Body -->
	<div data-if="section == 'body'">
		<div class="stitle">Body &amp; calibration</div>
		<div class="sdesc">Fit Shepard to you.</div>
		<div class="hero">
			<div class="big"/>
			<div class="herot">
				<div class="heroh">Full calibration</div>
				<div class="herop">About a minute in a clear space: your height, arms and crouch, then aim a pistol and a rifle the way you naturally would. Saved for these controllers.</div>
				<div class="stat" data-class-warn="!calibrated"><div class="ico i-check" data-if="calibrated"/><div class="ico i-info" data-if="!calibrated"/><span>{{cal_status}}</span></div>
			</div>
			<button class="btn primary" id="calibrate" data-event-click="cmd('calibrate')"><div class="sweep"/><div class="bi i-target"/><span>{{cal_action}}</span></button>
		</div>
		<div class="tiles">
			<div class="tile"><div class="tl">Standing eye height</div><div class="tv">{{t_stand}}<span class="tu">m</span></div></div>
			<div class="tile"><div class="tl">Crouched eye height</div><div class="tv">{{t_crouch}}<span class="tu">m</span></div></div>
			<div class="tile"><div class="tl">Arm length</div><div class="tv">{{t_arm}}<span class="tu">m</span></div></div>
		</div>
		<div class="tiles last">
			<div class="tile"><div class="tl">Aiming eye</div><div class="tv">{{t_eye}}</div></div>
			<div class="tile"><div class="tl">Pistol aim spread</div><div class="tv">{{t_pistol}}<span class="tu">°</span></div></div>
			<div class="tile"><div class="tl">Rifle aim spread</div><div class="tv">{{t_rifle}}<span class="tu">°</span></div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Quick fixes</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Recenter</div><div class="rdesc">Turn the view to face where you look (a badly tilted start is levelled too); also: double-click the right stick</div></div>
				<button class="btn" data-event-click="cmd('recenter')"><div class="sweep"/><div class="bi i-recenter"/><span>Recenter</span><div class="tick"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Line up with Shepard's head</div><div class="rdesc">Closes the menu: stand naturally, then pull the left trigger</div><div class="note" data-if="align_msg != ''">{{align_msg}}</div></div>
				<button class="btn" data-event-click="cmd('align')"><div class="sweep"/><div class="bi i-align"/><span>Align</span><div class="tick"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Measure arms only</div><div class="rdesc">Arms straight out to the sides (a T), then pull either trigger</div><div class="note" data-if="measure_msg != ''">{{measure_msg}}</div></div>
				<button class="btn" data-event-click="cmd('measure')"><div class="sweep"/><span>Measure</span><div class="tick"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Fine adjustments</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Hand angle trims</div><div class="rdesc">Small corrections on top of the calibration, the same for both hands</div></div>
				<button class="btn" data-event-click="fine = !fine"><div class="sweep"/><span data-if="!fine">Show</span><span data-if="fine">Hide</span><div class="tick"/></button></div>
			<div data-if="fine">
				<div class="srow"><div class="slab">Pitch</div><input type="range" min="-30" max="30" step="1" data-value="trim_pitch"/><div class="sval">{{trim_pitch_text}}</div></div>
				<div class="srow"><div class="slab">Yaw</div><input type="range" min="-30" max="30" step="1" data-value="trim_yaw"/><div class="sval">{{trim_yaw_text}}</div></div>
				<div class="srow"><div class="slab">Roll</div><input type="range" min="-30" max="30" step="1" data-value="trim_roll"/><div class="sval">{{trim_roll_text}}</div></div>
			</div>
		</div>
	</div>

	<!-- ===================================================================================== Display -->
	<div data-if="section == 'display'">
		<div class="stitle">Display</div>
		<div class="sdesc">How the game looks in your headset.</div>
		<div class="group">
			<div class="gtitle"><span>Colour</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Colour profile</div><div class="rdesc">Matched to your headset's display and its video link</div></div>
				<div class="seg"><button class="segb" data-class-on="profile == 'auto'" data-event-click="pick('profile','auto')">Auto</button><button class="segb" data-class-on="profile == 'neutral'" data-event-click="pick('profile','neutral')">Neutral</button><button class="segb" data-class-on="profile == 'vivid'" data-event-click="pick('profile','vivid')">Vivid</button><button class="segb" data-class-on="profile == 'custom'" data-event-click="pick('profile','custom')">Custom</button></div></div>
			<div class="info"><div class="ico i-info"/><span>{{profile_info}}</span></div>
			<div class="colour">
				<div class="left">
					<div class="srow"><div class="slab">Brightness</div><input type="range" min="-20" max="20" step="1" data-value="c_brightness"/><div class="sval">{{c_brightness_text}}</div></div>
					<div class="srow"><div class="slab">Contrast</div><input type="range" min="-20" max="30" step="1" data-value="c_contrast"/><div class="sval">{{c_contrast_text}}</div></div>
					<div class="srow"><div class="slab">Saturation</div><input type="range" min="-30" max="40" step="1" data-value="c_saturation"/><div class="sval">{{c_saturation_text}}</div></div>
					<div class="srow"><div class="slab">Mid-tones</div><input type="range" min="0.7" max="1.3" step="0.01" data-value="c_midtones"/><div class="sval">{{c_midtones_text}}</div></div>
					<div class="srow"><div class="slab">Black level</div><input type="range" min="-0.05" max="0.05" step="0.005" data-value="c_black"/><div class="sval">{{c_black_text}}</div></div>
					<div class="hint"><span class="key">A</span><span data-if="!comparing">Hold to flip between the original and the adjusted image.</span><span class="comparing" data-if="comparing">Showing the original picture.</span></div>
				</div>
				<div class="pv">
					<div class="pvcols">
						<div><div class="pvlab">Original</div><img class="pvimg" src="mevr:strip_original"/></div>
						<div><div class="pvlab">Adjusted</div><img class="pvimg" src="mevr:strip_adjusted"/></div>
					</div>
					<div class="pvnote">The grey steps should all stay distinct, the darkest from black and the brightest from white.</div>
				</div>
			</div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Image quality</span><div class="gline"/></div>
			<!-- One choice for the frame rate (research/60): each mode sets the render resolution and the levers in Advanced >
			     Performance; any of them changed by hand shows Custom. -->
			<div class="row"><div class="rl"><div class="rlab">Performance</div><div class="rdesc">{{perf_desc}}</div><div class="note">{{perf_note}}</div></div>
				<div class="seg"><button class="segb" data-class-on="perf_mode == 'quality'" data-event-click="pick('perf_mode','quality')">Quality</button><button class="segb" data-class-on="perf_mode == 'balanced'" data-event-click="pick('perf_mode','balanced')">Balanced</button><button class="segb" data-class-on="perf_mode == 'performance'" data-event-click="pick('perf_mode','performance')">Performance</button><button class="segb on shown" data-if="perf_mode == 'custom'">Custom</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Render resolution</div><div class="rdesc">Now {{quality_text}} per eye · {{quality_note}}</div><div class="rdesc">{{headset_text}}</div></div>
				<div class="seg"><button class="segb disabled" data-if="!headset_known">Headset (unknown until VR starts)</button><button class="segb" data-if="headset_known" data-class-on="quality == 'headset'" data-event-click="pick('quality','headset')">Headset</button><button class="segb" data-if="headset_known" data-class-on="quality == 'headset85'" data-event-click="pick('quality','headset85')">Headset × 0.85</button><button class="segb" data-if="headset_known" data-class-on="quality == 'headset75'" data-event-click="pick('quality','headset75')">Headset × 0.75</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Upscale</div><div class="rdesc">Renders smaller and sharpens it back up: faster, a little softer. Pairs with Headset × 0.85.</div></div>
				<div class="seg"><button class="segb" data-class-on="upscale == 'off'" data-event-click="pick('upscale','off')">Off</button><button class="segb" data-class-on="upscale == 'fsr'" data-event-click="pick('upscale','fsr')">FSR</button></div></div>
			<div class="row" id="steamvr-smoothing-row" data-if="steamvr_runtime"><div class="rl"><div class="rlab">Motion smoothing (SteamVR)</div><div class="rdesc">SteamVR fills in frames the game misses by warping older ones. Off shows only real frames. For the Steam version of the game.</div><div class="note">{{steamvr_smoothing_note}}</div></div>
				<div class="seg"><button class="segb" data-class-on="steamvr_smoothing == 'steamvr'" data-event-click="cmd('steamvr_smoothing','steamvr')">SteamVR decides</button><button class="segb" data-class-on="steamvr_smoothing == 'off'" data-event-click="cmd('steamvr_smoothing','off')">Off</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Steady cutscenes</div><div class="rdesc">Caps cutscenes to a frame rate the headset can hold</div></div>
				<button class="tog" data-class-on="steady_cine" data-event-click="toggle('steady_cine')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Optional content</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Voice orders and texture packs</div><div class="rdesc">Installed: {{content_installed}}</div><div class="note" data-if="content_msg != ''">{{content_msg}}</div></div>
				<button class="btn" data-event-click="cmd('content_request')"><div class="sweep"/><span>Install after I quit</span><div class="tick"/></button></div>
			<div class="hint">They go in the game's folder, so MEVR Setup adds them while the game is closed.</div>
		</div>
	</div>

	<!-- ===================================================================================== HUD -->
	<div data-if="section == 'hud'">
		<div class="stitle">HUD &amp; sights</div>
		<div class="sdesc">What's drawn over the world.</div>
		<div class="group">
			<div class="gtitle"><span>HUD</span><div class="gline"/></div>
			<div class="srow d"><div class="sl"><div class="slab">Distance</div><div class="rdesc">How far in front of you the HUD floats</div></div><input type="range" min="1" max="3" step="0.1" data-value="hud_distance"/><div class="sval">{{hud_distance_text}}</div></div>
			<div class="srow d"><div class="sl"><div class="slab">Size</div><div class="rdesc">How wide it is: 100% is 1.3 m</div></div><input type="range" min="45" max="155" step="5" data-value="hud_size"/><div class="sval">{{hud_size_text}}</div></div>
			<div class="srow d"><div class="sl"><div class="slab">Below your eyes</div><div class="rdesc">How far below eye height its middle sits</div></div><input type="range" min="-0.3" max="0.6" step="0.01" data-value="panel_below"/><div class="sval">{{panel_below_text}}</div></div>
			<div class="srow d"><div class="sl"><div class="slab">Comes round past</div><div class="rdesc">Look this far aside for a second and it moves back in front of you</div></div><input type="range" min="0" max="120" step="5" data-value="panel_follow"/><div class="sval">{{panel_follow_text}}</div></div>
			<div class="row"><div class="rl"><div class="rlab">Bring it in front of me</div><div class="rdesc">Puts the HUD straight ahead of where you look now (recentering does too)</div></div>
				<button class="btn" data-event-click="cmd('place_hud')"><div class="sweep"/><div class="bi i-place"/><span>Place</span><div class="tick"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Hand reticle</div><div class="rdesc">A marker where the gun points, instead of the screen crosshair</div></div>
				<button class="tog" data-class-on="reticle" data-event-click="toggle('reticle')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>On you and in the world</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Status on your wrist</div><div class="rdesc">Health, shields, your squad and medi-gel on the back of your left wrist, out of the HUD</div></div>
				<button class="tog" data-class-on="wrist_status" data-event-click="toggle('wrist_status')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Weapon panel on the gun</div><div class="rdesc">The gun's heat and your grenades on top of the drawn gun, out of the HUD</div></div>
				<button class="tog" data-class-on="gun_status" data-event-click="toggle('gun_status')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Prompts at the object</div><div class="rdesc">What A will use (a door, a console, a person) is named where it is, big enough to read. Off: small on the HUD.</div></div>
				<button class="tog" data-class-on="interact_label" data-event-click="toggle('interact_label')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Sights</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Pistol</div><div class="rdesc">Seen by the eye you aim with: a red dot, or a holo ring around a dot</div></div>
				<div class="seg"><button class="segb" data-class-on="sight_pistol == 'dot'" data-event-click="pick('sight_pistol','dot')">Red dot</button><button class="segb" data-class-on="sight_pistol == 'holo'" data-event-click="pick('sight_pistol','holo')">Holo</button><button class="segb" data-class-on="sight_pistol == 'none'" data-event-click="pick('sight_pistol','none')">None</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Shotgun</div><div class="rdesc">The same choice for the shotgun</div></div>
				<div class="seg"><button class="segb" data-class-on="sight_shotgun == 'dot'" data-event-click="pick('sight_shotgun','dot')">Red dot</button><button class="segb" data-class-on="sight_shotgun == 'holo'" data-event-click="pick('sight_shotgun','holo')">Holo</button><button class="segb" data-class-on="sight_shotgun == 'none'" data-event-click="pick('sight_shotgun','none')">None</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Assault rifle</div><div class="rdesc">A sight, or the rifle's own small scope</div></div>
				<div class="seg"><button class="segb" data-class-on="sight_rifle == 'dot'" data-event-click="pick('sight_rifle','dot')">Red dot</button><button class="segb" data-class-on="sight_rifle == 'scope'" data-event-click="pick('sight_rifle','scope')">Scope 1.5×</button><button class="segb" data-class-on="sight_rifle == 'holo'" data-event-click="pick('sight_rifle','holo')">Holo</button><button class="segb" data-class-on="sight_rifle == 'none'" data-event-click="pick('sight_rifle','none')">None</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Sniper rifle</div><div class="rdesc">The game's own scope view and zoom; flick the right stick to zoom while aiming down it</div></div>
				<div class="seg"><button class="segb" data-class-on="sight_sniper == 'scope'" data-event-click="pick('sight_sniper','scope')">Scope</button><button class="segb" data-class-on="sight_sniper == 'dot'" data-event-click="pick('sight_sniper','dot')">Red dot</button><button class="segb" data-class-on="sight_sniper == 'holo'" data-event-click="pick('sight_sniper','holo')">Holo</button><button class="segb" data-class-on="sight_sniper == 'none'" data-event-click="pick('sight_sniper','none')">None</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Sight alignment help</div><div class="rdesc">Raised to your eye, the gun eases the sight onto your line of view</div></div>
				<button class="tog" data-class-on="sight_assist" data-event-click="toggle('sight_assist')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Shots land on the dot</div><div class="rdesc">Each shot aims at whatever the sight line points at, near or far</div></div>
				<button class="tog" data-class-on="sight_converge" data-event-click="toggle('sight_converge')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Scope picture in the game's colours</div><div class="rdesc">The zoomed picture gets the game's colour grade, with a dark speckle in shadows. Off: clean, plainer colours. From the next loading screen.</div></div>
				<button class="tog" data-class-on="scope_grade" data-event-click="toggle('scope_grade')"><div class="knob"/></button></div>
		</div>
	</div>

	<!-- ===================================================================================== Advanced -->
	<div data-if="section == 'advanced'">
		<div class="stitle">Advanced</div>
		<div class="sdesc">Fine-tuning and troubleshooting. The standard settings suit most players.</div>
		<div class="advwrap"><div class="seg advtabs">
			<button class="segb" data-class-on="advtab == 'tracking'" data-event-click="advtab = 'tracking'">Tracking</button>
			<button class="segb" data-class-on="advtab == 'fp'" data-event-click="advtab = 'fp'">First person</button>
			<button class="segb" data-class-on="advtab == 'view'" data-event-click="advtab = 'view'">View</button>
			<button class="segb" data-class-on="advtab == 'stereo'" data-event-click="advtab = 'stereo'">Stereo</button>
			<button class="segb" data-class-on="advtab == 'perf'" data-event-click="advtab = 'perf'">Performance</button>
			<button class="segb" data-class-on="advtab == 'hud'" data-event-click="advtab = 'hud'">Game UI</button>
			<button class="segb" data-class-on="advtab == 'profiles'" data-event-click="advtab = 'profiles'">Profiles</button>
			<button class="segb" data-class-on="advtab == 'diag'" data-event-click="advtab = 'diag'">Diagnostics</button>
		</div></div>

		<div data-if="advtab == 'tracking'">
			<div class="group">
				<div class="gtitle"><span>Head tracking</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Recenter key</div><div class="rdesc">{{recenter_key_desc}}</div></div>
					<button class="tog" data-class-on="recenter_key" data-event-click="toggle('recenter_key')"><div class="knob"/></button></div>
				<div class="srow d"><div class="sl"><div class="slab">Smoothing</div><div class="rdesc">Steadies the picture while your head is still; more feels laggy</div></div><input type="range" min="0" max="0.9" step="0.05" data-value="look_smooth"/><div class="sval">{{look_smooth_text}}</div></div>
			</div>
			<div class="group">
				<div class="gtitle"><span>Flat screens</span><div class="gline"/></div>
				<div class="hint">Conversations and cutscenes are on the Comfort page.</div>
				<div class="row"><div class="rl"><div class="rlab">Flat game menus</div><div class="rdesc">Full-screen game menus the room doesn't take go on a flat screen in front of you, easy to read. Off: drawn in 3D.</div></div>
					<button class="tog" data-class-on="flat_menus" data-event-click="toggle('flat_menus')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Flat galaxy map</div><div class="rdesc">A full-screen galaxy map goes on a flat screen. Off: drawn in 3D.</div></div>
					<button class="tog" data-class-on="flat_galaxy" data-event-click="toggle('flat_galaxy')"><div class="knob"/></button></div>
			</div>
		</div>

		<div data-if="advtab == 'fp'">
			<div class="group">
				<div class="gtitle"><span>First-person camera</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">First person</div><div class="rdesc">Off: the game's own third-person camera (also: K)</div></div>
					<button class="tog" data-class-on="fp_on" data-event-click="toggle('fp_on')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Hide Shepard's head</div><div class="rdesc">Keeps hair and helmet out of your view</div></div>
					<button class="tog" data-class-on="fp_hide_head" data-event-click="toggle('fp_hide_head')"><div class="knob"/></button></div>
				<div class="srow"><div class="slab">Back</div><input type="range" min="-2" max="2" step="0.01" data-value="fp_back"/><div class="sval">{{fp_back_text}}</div></div>
				<div class="srow"><div class="slab">Right</div><input type="range" min="-1" max="1" step="0.01" data-value="fp_right"/><div class="sval">{{fp_right_text}}</div></div>
				<div class="srow"><div class="slab">Up</div><input type="range" min="-1" max="1" step="0.01" data-value="fp_up"/><div class="sval">{{fp_up_text}}</div></div>
				<div class="hint">Body &amp; calibration's "Line up with Shepard's head" sets these for you.</div>
			</div>
		</div>

		<div data-if="advtab == 'view'">
			<div class="group">
				<div class="gtitle"><span>Lean and view</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Lean</div><div class="rdesc">Leaning and stepping move the camera</div></div>
					<button class="tog" data-class-on="lean" data-event-click="toggle('lean')"><div class="knob"/></button></div>
				<div class="srow d"><div class="sl"><div class="slab">Flat screen width</div><div class="rdesc">The flat screen for menus, the map and flat cutscenes</div></div><input type="range" min="1" max="3.5" step="0.05" data-value="flat_size"/><div class="sval">{{flat_size_text}}</div></div>
				<div class="row"><div class="rl"><div class="rlab">Fill the field of view</div><div class="rdesc">Stretches the game's picture to the headset's full view</div></div>
					<button class="tog" data-class-on="fov_fill" data-event-click="toggle('fov_fill')"><div class="knob"/></button></div>
			</div>
		</div>

		<div data-if="advtab == 'stereo'">
			<div class="group">
				<div class="gtitle"><span>Stereo</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">VR mode</div><div class="rdesc">Stereo: each eye rendered on its own (the standard). Mono: one picture for both eyes, no depth, faster. Depth: the second eye made from the first one's depth, faster, with fringes at edges. Mono and Depth aren't tested with hand aiming. Needs a restart.</div><div class="note" data-if="mode_note != ''">{{mode_note}}</div></div>
					<div class="seg"><button class="segb" data-class-on="vr_mode == 'mono'" data-event-click="pick('vr_mode','mono')">Mono</button><button class="segb" data-class-on="vr_mode == 'stereo'" data-event-click="pick('vr_mode','stereo')">Stereo</button><button class="segb" data-class-on="vr_mode == 'dibr'" data-event-click="pick('vr_mode','dibr')">Depth</button></div></div>
				<div class="row"><div class="rl"><div class="rlab">Real eye positions</div><div class="rdesc">Each eye sees from where it really is, so depth and sizes are true (life-size). Off: the original MELE-VR stereo, set by hand below.</div></div>
					<button class="tog" data-class-on="life_size" data-event-click="toggle('life_size')"><div class="knob"/></button></div>
				<div data-if="life_size">
					<div class="srow d"><div class="sl"><div class="slab">Extra depth</div><div class="rdesc">1.00× is your own eye distance; more makes depth stronger and the world smaller</div></div><input type="range" min="0.5" max="2" step="0.05" data-value="extra_depth"/><div class="sval">{{extra_depth_text}}</div></div>
					<div class="row"><div class="rl"><div class="rlab">Each eye's own field of view</div><div class="rdesc">Renders each eye's real, off-centre view so the whole image is used. Off: one shared window for both eyes</div></div>
						<button class="tog" data-class-on="eye_frustum" data-event-click="toggle('eye_frustum')"><div class="knob"/></button></div>
				</div>
				<div data-if="!life_size">
					<div class="hint">Expert: the original stereo's own settings, used only while Real eye positions is off.</div>
					<div class="srow d"><div class="sl"><div class="slab">Eye distance</div><div class="rdesc">How far apart the two cameras are, in Shepard's centimetres (yours: about 6.3). Wider makes the world smaller.</div></div><input type="range" min="1" max="16" step="0.2" data-value="eye_distance"/><div class="sval">{{eye_distance_text}}</div></div>
					<div class="srow d"><div class="sl"><div class="slab">Convergence</div><div class="rdesc">Shifts the two pictures sideways so near prompts and far scenery both fuse; 0 is no shift</div></div><input type="range" min="-0.02" max="0.05" step="0.001" data-value="convergence"/><div class="sval">{{convergence_text}}</div></div>
					<div class="row"><div class="rl"><div class="rlab">Swap eyes</div><div class="rdesc">If depth looks inside out</div></div>
						<button class="tog" data-class-on="swap_eyes" data-event-click="toggle('swap_eyes')"><div class="knob"/></button></div>
				</div>
				<div class="row"><div class="rl"><div class="rlab">Quest Link image fix</div><div class="rdesc">Fixes a doubled picture with a Quest on Meta's Link or Air Link. It does nothing through SteamVR or Virtual Desktop, so leave it on.</div></div>
					<button class="tog" data-class-on="quest_fov" data-event-click="toggle('quest_fov')"><div class="knob"/></button></div>
			</div>
			<div class="group">
				<div class="gtitle"><span>Graphics</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Depth of field</div><div class="rdesc">Turning it off sharpens the background but washes out colour (after a restart)</div></div>
					<button class="tog" data-class-on="dof" data-event-click="toggle('dof')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Desktop mirror</div><div class="rdesc">How often the game window on your monitor updates. Every 2nd is the standard; every frame is smooth for recording but costs frame rate.</div></div>
					<div class="seg"><button class="segb" data-class-on="mirror == 'normal'" data-event-click="pick('mirror','normal')">Every 8th</button><button class="segb" data-class-on="mirror == 'smooth'" data-event-click="pick('mirror','smooth')">Every 2nd</button><button class="segb" data-class-on="mirror == 'every'" data-event-click="pick('mirror','every')">Every frame</button></div></div>
			</div>
		</div>

		<!-- Performance: the levers Display's Performance modes set, one by one (research/60), and Halcyon's fixed render sizes. -->
		<div data-if="advtab == 'perf'">
			<div class="group">
				<div class="gtitle"><span>Performance levers</span><div class="gline"/></div>
				<div class="hint">Display's Performance modes set these. Changing one makes the mode Custom. All of them apply at once.</div>
				<div class="row"><div class="rl"><div class="rlab">Small-object culling</div><div class="rdesc">Skips objects smaller than this many pixels on screen. Up to 8 can't be seen; from 24 far details pop in.</div></div>
					<div class="seg"><button class="segb" data-class-on="cull_px == '0'" data-event-click="pick('cull_px','0')">Off</button><button class="segb" data-class-on="cull_px == '4'" data-event-click="pick('cull_px','4')">4</button><button class="segb" data-class-on="cull_px == '8'" data-event-click="pick('cull_px','8')">8</button><button class="segb" data-class-on="cull_px == '16'" data-event-click="pick('cull_px','16')">16</button><button class="segb" data-class-on="cull_px == '24'" data-event-click="pick('cull_px','24')">24</button><button class="segb" data-class-on="cull_px == '32'" data-event-click="pick('cull_px','32')">32</button></div></div>
				<div class="srow d"><div class="sl"><div class="slab">Grass distance</div><div class="rdesc">Of the game's own. Grass costs on the processor and the graphics card for every blade, twice in VR.</div></div><input type="range" min="25" max="100" step="5" data-value="grass"/><div class="sval">{{grass_text}}</div></div>
				<div class="row"><div class="rl"><div class="rlab">Dynamic shadows</div><div class="rdesc">Moving shadows from characters and lights. Off is the standard: they cost frame time and the game's own shadows stay.</div></div>
					<button class="tog" data-class-on="dyn_shadows" data-event-click="toggle('dyn_shadows')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Ambient occlusion</div><div class="rdesc">Soft shading in corners and under objects. Off saves graphics-card time and flattens the picture a little.</div></div>
					<button class="tog" data-class-on="ambient_occl" data-event-click="toggle('ambient_occl')"><div class="knob"/></button></div>
				<div class="srow d"><div class="sl"><div class="slab">FSR sharpness</div><div class="rdesc">How much the upscale sharpens a smaller render. No mode sets it.</div></div><input type="range" min="0" max="100" step="5" data-value="fsr_sharpness"/><div class="sval">{{fsr_sharpness_text}}</div></div>
			</div>
			<div class="group">
				<div class="gtitle"><span>Fixed render sizes</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Fixed sizes</div><div class="rdesc">The original MELE-VR sizes, in pixels wide per eye. Above your headset's own size the picture gets sharper, but each step costs a lot of frame rate. Applies after a restart.</div></div>
					<div class="seg"><button class="segb" data-class-on="quality == 'low'" data-event-click="pick('quality','low')">2048</button><button class="segb" data-class-on="quality == 'performance'" data-event-click="pick('quality','performance')">3072</button><button class="segb" data-class-on="quality == 'balanced'" data-event-click="pick('quality','balanced')">4096</button><button class="segb" data-class-on="quality == 'sharp'" data-event-click="pick('quality','sharp')">5120</button><button class="segb" data-class-on="quality == 'max'" data-event-click="pick('quality','max')">6144</button></div></div>
			</div>
		</div>

		<!-- The game's conversation wheel and mission overlays: their size and place (Halcyon's HUD tab's transforms). The combat
		     HUD has none here: the HUD panel shows it at the game's own layout (HUD & sights sizes the panel). -->
		<div data-if="advtab == 'hud'">
			<div class="group">
				<div class="gtitle"><span>Conversation wheel</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Fit it to your view</div><div class="rdesc">The dialogue wheel and conversation captions at the size and place below. Off: the game's own size and place.</div></div>
					<button class="tog" data-class-on="g_convo" data-event-click="toggle('g_convo')"><div class="knob"/></button></div>
				<div class="srow" data-class-disabled="!g_convo"><div class="slab">Size</div><input type="range" min="40" max="250" step="5" data-value="convo_size"/><div class="sval">{{convo_size_text}}</div></div>
				<div class="srow" data-class-disabled="!g_convo"><div class="slab">Left / right</div><input type="range" min="-600" max="600" step="10" data-value="convo_x"/><div class="sval">{{convo_x_text}}</div></div>
				<div class="srow" data-class-disabled="!g_convo"><div class="slab">Down / up</div><input type="range" min="-600" max="600" step="10" data-value="convo_y"/><div class="sval">{{convo_y_text}}</div></div>
				<div class="row" data-class-disabled="!g_convo"><div class="rl"><div class="rlab">Standard size and place</div><div class="rdesc">Open this menu during a conversation to see the wheel change as you move the sliders</div></div>
					<button class="btn" data-event-click="cmd('ui_reset','convo')"><div class="sweep"/><span>Standard</span><div class="tick"/></button></div>
			</div>
			<div class="group">
				<div class="gtitle"><span>Mission overlays</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Fit them to your view</div><div class="rdesc">Timers, charge counters and boss bars at the size and place below. Off: the game's own size and place.</div></div>
					<button class="tog" data-class-on="g_designer" data-event-click="toggle('g_designer')"><div class="knob"/></button></div>
				<div class="srow" data-class-disabled="!g_designer"><div class="slab">Size</div><input type="range" min="40" max="250" step="5" data-value="designer_size"/><div class="sval">{{designer_size_text}}</div></div>
				<div class="srow" data-class-disabled="!g_designer"><div class="slab">Left / right</div><input type="range" min="-900" max="900" step="10" data-value="designer_x"/><div class="sval">{{designer_x_text}}</div></div>
				<div class="srow" data-class-disabled="!g_designer"><div class="slab">Down / up</div><input type="range" min="-900" max="900" step="10" data-value="designer_y"/><div class="sval">{{designer_y_text}}</div></div>
				<div class="row" data-class-disabled="!g_designer"><div class="rl"><div class="rlab">Standard size and place</div><div class="rdesc">The change shows the next time an overlay is on screen</div></div>
					<button class="btn" data-event-click="cmd('ui_reset','designer')"><div class="sweep"/><span>Standard</span><div class="tick"/></button></div>
			</div>
		</div>

		<div data-if="advtab == 'profiles'">
			<div class="group">
				<div class="gtitle"><span>Profiles</span><div class="gline"/></div>
				<div class="tiles">
					<div class="tile" data-class-active="prof_active == '0'"><div class="tl"><span data-if="prof_active == '0'">Active</span><span data-if="prof_active != '0'">Saved</span></div><div class="tv">{{prof0_name}}</div>
						<div class="tbtns"><button class="btn small" data-event-click="cmd('prof_load','0')"><div class="sweep"/><span>Load</span></button><button class="btn small" data-event-click="cmd('prof_save','0')"><div class="sweep"/><span>Save</span></button></div></div>
					<div class="tile" data-class-active="prof_active == '1'"><div class="tl"><span data-if="prof_active == '1'">Active</span><span data-if="prof_active != '1'">Saved</span></div><div class="tv">{{prof1_name}}</div>
						<div class="tbtns"><button class="btn small" data-event-click="cmd('prof_load','1')"><div class="sweep"/><span>Load</span></button><button class="btn small" data-event-click="cmd('prof_save','1')"><div class="sweep"/><span>Save</span></button></div></div>
				</div>
				<div class="tiles last">
					<div class="tile" data-class-active="prof_active == '2'"><div class="tl"><span data-if="prof_active == '2'">Active</span><span data-if="prof_active != '2'">Saved</span></div><div class="tv">{{prof2_name}}</div>
						<div class="tbtns"><button class="btn small" data-event-click="cmd('prof_load','2')"><div class="sweep"/><span>Load</span></button><button class="btn small" data-event-click="cmd('prof_save','2')"><div class="sweep"/><span>Save</span></button></div></div>
					<div class="tile" data-class-active="prof_active == '3'"><div class="tl"><span data-if="prof_active == '3'">Active</span><span data-if="prof_active != '3'">Saved</span></div><div class="tv">{{prof3_name}}</div>
						<div class="tbtns"><button class="btn small" data-event-click="cmd('prof_load','3')"><div class="sweep"/><span>Load</span></button><button class="btn small" data-event-click="cmd('prof_save','3')"><div class="sweep"/><span>Save</span></button></div></div>
				</div>
				<div class="note" data-if="prof_msg != ''">{{prof_msg}}</div>
				<div class="hint">A profile keeps the VR view settings: these Advanced pages, the render resolution, the HUD's size and place and a few comfort choices. Your calibration, controls and colour are kept apart. Changes save into the active profile when the menu closes.</div>
			</div>
		</div>

		<div data-if="advtab == 'diag'">
			<div class="group">
				<div class="gtitle"><span>Diagnostics</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Report a problem</div><div class="rdesc">Saves the logs, settings and a summary for your AI assistant or an issue in a zip on your Desktop, in the background. Nothing is sent: open it after the game</div><div class="note" data-if="report_msg != ''">{{report_msg}}</div></div>
					<button class="btn" data-event-click="cmd('report')"><div class="sweep"/><div class="bi i-report"/><span>Report</span><div class="tick"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">With the latest snapshot</div><div class="rdesc">Take one first (below) if the problem is something you see</div></div>
					<button class="tog" data-class-on="report_snapshot" data-event-click="toggle('report_snapshot')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">With the latest frame timing</div><div class="rdesc">For stutter or a low frame rate: measure first (below)</div></div>
					<button class="tog" data-class-on="report_perf" data-event-click="toggle('report_perf')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Snapshot</div><div class="rdesc">Closes the menu and saves what each eye sees, for a bug report (also: tap both stick clicks)</div></div>
					<button class="btn" data-event-click="cmd('snapshot')"><div class="sweep"/><div class="bi i-camera"/><span>Take</span><div class="tick"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Record your movements</div><div class="rdesc">Records your head and hand movements, not the picture, into AppData\Local\MEVR\recordings. Attach the file to a bug report about tracking, aiming or your hands. Press again to stop.</div></div>
					<button class="btn" data-event-click="cmd('record')"><div class="sweep"/><div class="bi i-record"/><span data-if="!recording">Record</span><span data-if="recording">Stop</span><div class="tick"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Measure frame timing</div><div class="rdesc">Closes the menu and measures where each frame's time goes for 20 seconds, for a report about stutter</div><div class="note" data-if="perf_msg != ''">{{perf_msg}}</div></div>
					<button class="btn" data-event-click="cmd('perf')"><div class="sweep"/><div class="bi i-timer"/><span>Measure</span><div class="tick"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Reset VR settings</div><div class="rdesc">Puts the view, stereo and HUD settings back to standard for this session, not saved unless you save a profile. Your calibration, controls, resolution and first-person view are kept.</div><div class="note" data-if="diag_msg != ''">{{diag_msg}}</div></div>
					<button class="btn danger" data-class-armed="reset_armed" data-event-click="cmd('reset')"><div class="sweep"/><div class="bi i-trash"/><span data-if="!reset_armed">Reset</span><span data-if="reset_armed">Confirm</span><div class="tick"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Classic VR menu</div><div class="rdesc">{{classic_desc}}</div></div>
					<button class="btn" data-event-click="cmd('classic')"><div class="sweep"/><span>Open</span><div class="tick"/></button></div>
			</div>
			<div class="group">
				<div class="gtitle"><span>About</span><div class="gline"/></div>
				<div class="hint">{{about_build}}</div>
				<div class="hint">© 2026 ME VR Attempt contributors, Halcyon and Aeka0 · GPL-3.0, no warranty · source: github.com/dnehring/MEVR</div>
				<div class="hint">Fan project, not affiliated with or endorsed by EA or BioWare. Mass Effect is a trademark of EA International (Studio and Publishing) Ltd.</div>
			</div>
		</div>
	</div>

	</div>
</div>

<div class="hints">
	<span><span class="key">Trigger</span>Select</span>
	<span><span class="key">Right stick</span>Scroll</span>
	<span><span class="key">B</span>Back</span>
	<span><span class="key">Hold both sticks</span>Close</span>
</div>

<div id="pointer"><div class="dot"/></div>
</body>
</rml>
