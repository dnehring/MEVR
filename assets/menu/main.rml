<!-- SPDX-License-Identifier: MIT -->
<rml>
<head>
	<title>MEVR settings</title>
	<link type="text/rcss" href="main.rcss"/>
</head>
<!--
	MEVR's VR main menu (research/28), after the approved "glass" board. Every value is bound to the data model
	"menu" (plugin/menu/MenuModel: toggle('key'), pick('key', 'value'), cmd('name', 'arg'), sliders by data-value);
	what each key drives is in plugin/MainMenuSettings.cpp. Rows marked "soon" show what's planned and do nothing yet.
	Edit while the game runs: the menu reloads this file within a second of a save.
-->
<body data-model="menu">

<div class="top">
	<div class="brand">
		<div class="logo"/>
		<div><div class="brandName">MEVR</div><div class="brandSub">Settings</div></div>
	</div>
	<div class="topspace"/>
	<!-- The game's own menus: the way into them (no controller menu button can be counted on, e.g. a Quest over Link). -->
	<div class="gamebtns">
		<button class="btn game" id="game-menu" data-event-click="cmd('game_menu')"><div class="sweep"/><div class="bi i-gamemenu"/><div class="gl"><span class="gt">Game menu</span><span class="gs">Save, load, squad, map, options</span></div></button>
		<button class="btn game" id="game-back" data-event-click="cmd('game_back')"><div class="sweep"/><div class="bi i-holster"/><div class="gl"><span class="gt">Holster</span><span class="gs">The game's Back: puts the gun away</span></div></button>
	</div>
	<button class="btn primary" id="resume" data-event-click="cmd('resume')"><div class="sweep"/><div class="bi i-play"/><span>Resume</span></button>
</div>

<div class="main">
	<div class="rail">
		<button class="navb" id="nav-comfort" data-class-on="section == 'comfort'" data-event-click="section = 'comfort'"><div class="nico i-turn"/><div><div class="navl">Comfort</div><div class="navs">Turning, movement</div></div></button>
		<button class="navb" id="nav-controls" data-class-on="section == 'controls'" data-event-click="section = 'controls'"><div class="nico i-controls"/><div><div class="navl">Controls</div><div class="navs">Guns, holsters, grenades</div></div></button>
		<button class="navb" id="nav-body" data-class-on="section == 'body'" data-event-click="section = 'body'"><div class="nico i-body"/><div><div class="navl">Body &amp; calibration</div><div class="navs">Height, arms, aim</div></div></button>
		<button class="navb" id="nav-display" data-class-on="section == 'display'" data-event-click="section = 'display'"><div class="nico i-eye"/><div><div class="navl">Display</div><div class="navs">Colour, resolution</div></div></button>
		<button class="navb" id="nav-hud" data-class-on="section == 'hud'" data-event-click="section = 'hud'"><div class="nico i-crosshair"/><div><div class="navl">HUD &amp; sights</div><div class="navs">Panel, reticle, scopes</div></div></button>
		<button class="navb" id="nav-advanced" data-class-on="section == 'advanced'" data-event-click="section = 'advanced'"><div class="nico i-sliders"/><div><div class="navl">Advanced</div><div class="navs">Renderer, diagnostics</div></div></button>
		<div class="railspace"/>
		<!-- The headset, controllers and calibration (in the top bar until the game's menus took its room). -->
		<div class="chips">
			<div class="chip"><div class="ico i-headset"/><span>{{chip_headset}}</span></div>
			<div class="chip"><div class="ico i-controller"/><span>{{chip_controllers}}</span></div>
			<div class="chip" data-class-ok="calibrated"><div class="ico i-check"/><span>{{chip_calibrated}}</span></div>
		</div>
		<!-- A failed write of the settings file (a read-only ASI folder): nothing the menu changes is kept. -->
		<div class="note" data-if="save_msg != ''">{{save_msg}}</div>
	</div>

	<div class="content" id="content">

	<!-- ===================================================================================== Comfort -->
	<div data-if="section == 'comfort'">
		<div class="stitle">Comfort</div>
		<div class="sdesc">How you turn and move.</div>
		<div class="group">
			<div class="gtitle"><span>Turning</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Turn style</div><div class="rdesc">Snap jumps by an angle per flick of the right stick; smooth is the game's own turn while you hold it</div></div>
				<div class="seg"><button class="segb" data-class-on="turn == 'snap'" data-event-click="pick('turn','snap')">Snap</button><button class="segb" data-class-on="turn == 'smooth'" data-event-click="pick('turn','smooth')">Smooth</button></div></div>
			<div class="row" data-class-disabled="turn != 'snap'"><div class="rl"><div class="rlab">Snap angle</div><div class="rdesc">How far one flick turns you</div></div>
				<div class="seg"><button class="segb" data-class-on="snap == '30'" data-event-click="pick('snap','30')">30°</button><button class="segb" data-class-on="snap == '45'" data-event-click="pick('snap','45')">45°</button><button class="segb" data-class-on="snap == '60'" data-event-click="pick('snap','60')">60°</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Comfort vignette</div><div class="rdesc">Darkens the edges of your view while the stick turns you</div></div>
				<button class="tog" data-class-on="vignette" data-event-click="toggle('vignette')"><div class="knob"/></button></div>
			<div class="row" data-class-disabled="!vignette"><div class="rl"><div class="rlab">Vignette when</div><div class="rdesc">Only while turning, or while the left stick walks you too</div></div>
				<div class="seg"><button class="segb" data-class-on="vignette_when == 'turn'" data-event-click="pick('vignette_when','turn')">Turning</button><button class="segb" data-class-on="vignette_when == 'move'" data-event-click="pick('vignette_when','move')">Turning and moving</button></div></div>
			<div class="srow" data-class-disabled="!vignette"><div class="slab">Vignette strength</div><input type="range" min="10" max="100" step="5" data-value="vignette_strength"/><div class="sval">{{vignette_strength_text}}</div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Movement</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Walk toward</div><div class="rdesc">What the left stick's forward means: where you look, where your left hand points, or where Shepard faces</div></div>
				<div class="seg"><button class="segb" data-class-on="walk == 'head'" data-event-click="pick('walk','head')">Where I look</button><button class="segb" data-class-on="walk == 'hand'" data-event-click="pick('walk','hand')">Left hand</button><button class="segb" data-class-on="walk == 'body'" data-event-click="pick('walk','body')">Body</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Physical crouch</div><div class="rdesc">Crouch for real and Shepard crouches with you</div></div>
				<button class="tog" data-class-on="crouch" data-event-click="toggle('crouch')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Life-size movement</div><div class="rdesc">Your steps and leans move Shepard one to one</div></div>
				<button class="tog" data-class-on="lifesize" data-event-click="toggle('lifesize')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>This menu</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Pause while open</div><div class="rdesc">The game waits while you change settings</div></div>
				<button class="tog" data-class-on="pause" data-event-click="toggle('pause')"><div class="knob"/></button></div>
		</div>
	</div>

	<!-- ===================================================================================== Controls -->
	<div data-if="section == 'controls'">
		<div class="stitle">Controls</div>
		<div class="sdesc">Your hands are Shepard's hands.</div>
		<div class="group">
			<div class="gtitle"><span>Weapons</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Grip holds the gun</div><div class="rdesc">Squeeze to carry it; let go at its holster to put it away</div></div>
				<button class="tog" data-class-on="grip_holds" data-event-click="toggle('grip_holds')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Body holsters</div><div class="rdesc">Pistol at the right hip, rifle over the right shoulder, shotgun at the left hip, sniper over the left shoulder</div></div>
				<button class="tog" data-class-on="holsters" data-event-click="toggle('holsters')"><div class="knob"/></button></div>
			<div class="srow"><div class="slab">Holster buzz</div><input type="range" min="0" max="100" step="5" data-value="holster_buzz"/><div class="sval">{{holster_buzz_text}}</div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Left hand</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Left trigger</div><div class="rdesc">Aimed fire comes from holding the gun with both hands at your shoulder</div></div>
				<div class="seg"><button class="segb" data-class-on="left_trigger == 'lb'" data-event-click="pick('left_trigger','lb')">Weapon wheel</button><button class="segb" data-class-on="left_trigger == 'lt'" data-event-click="pick('left_trigger','lt')">Aim</button><button class="segb" data-class-on="left_trigger == 'none'" data-event-click="pick('left_trigger','none')">Off</button></div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Combat</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Physical grenades and melee</div><div class="rdesc">Take a grenade from your left chest and throw it; strike to melee</div><div class="note" data-if="throwables_note != ''">{{throwables_note}}</div></div>
				<button class="tog" data-class-on="throwables" data-event-click="toggle('throwables')"><div class="knob"/></button></div>
			<div class="srow"><div class="slab">Recoil buzz</div><input type="range" min="0" max="100" step="5" data-value="recoil_buzz"/><div class="sval">{{recoil_buzz_text}}</div></div>
			<div class="row"><div class="rl"><div class="rlab">Aim assist</div><div class="rdesc">Off: the stick turns you at the speed you ask, even near enemies</div></div>
				<button class="tog" data-class-on="aim_assist" data-event-click="toggle('aim_assist')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Weapon drawn</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Body stays relaxed</div><div class="rdesc">With a gun out Shepard keeps the explore pose under you; shots, grenades and powers work as before</div></div>
				<button class="tog" data-class-on="explore_stance" data-event-click="toggle('explore_stance')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Steady view</div><div class="rdesc">Drawing, holstering, aiming and sprinting leave your eyes where they are</div></div>
				<button class="tog" data-class-on="constant_eye" data-event-click="toggle('constant_eye')"><div class="knob"/></button></div>
			<div class="srow"><div class="slab">Draw speed</div><input type="range" min="1" max="10" step="0.5" data-value="draw_rate"/><div class="sval">{{draw_rate_text}}</div></div>
		</div>
	</div>

	<!-- ===================================================================================== Body -->
	<div data-if="section == 'body'">
		<div class="stitle">Body &amp; calibration</div>
		<div class="sdesc">Fit Shepard to you.</div>
		<div class="hero">
			<div class="big"/>
			<div class="herot">
				<div class="heroh">Full calibration</div>
				<div class="herop">About a minute in a clear space: your height, arms and crouch, then aim a pistol and a rifle the way you naturally would. Saved for these controllers.</div>
				<div class="stat" data-class-warn="!calibrated"><div class="ico i-check" data-if="calibrated"/><div class="ico i-info" data-if="!calibrated"/><span>{{cal_status}}</span></div>
			</div>
			<button class="btn primary" id="calibrate" data-event-click="cmd('calibrate')"><div class="sweep"/><div class="bi i-target"/><span>{{cal_action}}</span></button>
		</div>
		<div class="tiles">
			<div class="tile"><div class="tl">Standing eye height</div><div class="tv">{{t_stand}}<span class="tu">m</span></div></div>
			<div class="tile"><div class="tl">Crouched eye height</div><div class="tv">{{t_crouch}}<span class="tu">m</span></div></div>
			<div class="tile"><div class="tl">Arm length</div><div class="tv">{{t_arm}}<span class="tu">m</span></div></div>
		</div>
		<div class="tiles last">
			<div class="tile"><div class="tl">Aiming eye</div><div class="tv">{{t_eye}}</div></div>
			<div class="tile"><div class="tl">Pistol aim spread</div><div class="tv">{{t_pistol}}<span class="tu">°</span></div></div>
			<div class="tile"><div class="tl">Rifle aim spread</div><div class="tv">{{t_rifle}}<span class="tu">°</span></div></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Quick fixes</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Recenter</div><div class="rdesc">Turn the view to face where you look (a badly tilted start is levelled too); also: double-click the right stick</div></div>
				<button class="btn" data-event-click="cmd('recenter')"><div class="sweep"/><div class="bi i-recenter"/><span>Recenter</span><div class="tick"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Line up with Shepard's head</div><div class="rdesc">Closes the menu: stand naturally, then pull the left trigger</div><div class="note" data-if="align_msg != ''">{{align_msg}}</div></div>
				<button class="btn" data-event-click="cmd('align')"><div class="sweep"/><div class="bi i-align"/><span>Align</span><div class="tick"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Measure arms only</div><div class="rdesc">Arms straight out to the sides (a T), then pull either trigger</div><div class="note" data-if="measure_msg != ''">{{measure_msg}}</div></div>
				<button class="btn" data-event-click="cmd('measure')"><div class="sweep"/><span>Measure</span><div class="tick"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Fine adjustments</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Hand angle trims</div><div class="rdesc">Small corrections on top of the calibration, the same for both hands</div></div>
				<button class="btn" data-event-click="fine = !fine"><div class="sweep"/><span data-if="!fine">Show</span><span data-if="fine">Hide</span><div class="tick"/></button></div>
			<div data-if="fine">
				<div class="srow"><div class="slab">Pitch</div><input type="range" min="-30" max="30" step="1" data-value="trim_pitch"/><div class="sval">{{trim_pitch_text}}</div></div>
				<div class="srow"><div class="slab">Yaw</div><input type="range" min="-30" max="30" step="1" data-value="trim_yaw"/><div class="sval">{{trim_yaw_text}}</div></div>
				<div class="srow"><div class="slab">Roll</div><input type="range" min="-30" max="30" step="1" data-value="trim_roll"/><div class="sval">{{trim_roll_text}}</div></div>
			</div>
		</div>
	</div>

	<!-- ===================================================================================== Display -->
	<div data-if="section == 'display'">
		<div class="stitle">Display</div>
		<div class="sdesc">How the game looks in your headset.</div>
		<div class="group">
			<div class="gtitle"><span>Colour</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Colour profile</div><div class="rdesc">Matched to your headset's display and its video link</div></div>
				<div class="seg"><button class="segb" data-class-on="profile == 'auto'" data-event-click="pick('profile','auto')">Auto</button><button class="segb" data-class-on="profile == 'neutral'" data-event-click="pick('profile','neutral')">Neutral</button><button class="segb" data-class-on="profile == 'vivid'" data-event-click="pick('profile','vivid')">Vivid</button><button class="segb" data-class-on="profile == 'custom'" data-event-click="pick('profile','custom')">Custom</button></div></div>
			<div class="info"><div class="ico i-info"/><span>{{profile_info}}</span></div>
			<div class="colour">
				<div class="left">
					<div class="srow"><div class="slab">Brightness</div><input type="range" min="-20" max="20" step="1" data-value="c_brightness"/><div class="sval">{{c_brightness_text}}</div></div>
					<div class="srow"><div class="slab">Contrast</div><input type="range" min="-20" max="30" step="1" data-value="c_contrast"/><div class="sval">{{c_contrast_text}}</div></div>
					<div class="srow"><div class="slab">Saturation</div><input type="range" min="-30" max="40" step="1" data-value="c_saturation"/><div class="sval">{{c_saturation_text}}</div></div>
					<div class="srow"><div class="slab">Mid-tones</div><input type="range" min="0.7" max="1.3" step="0.01" data-value="c_midtones"/><div class="sval">{{c_midtones_text}}</div></div>
					<div class="srow"><div class="slab">Black level</div><input type="range" min="-0.05" max="0.05" step="0.005" data-value="c_black"/><div class="sval">{{c_black_text}}</div></div>
					<div class="hint"><span class="key">A</span><span data-if="!comparing">Hold to flip between the original and the adjusted image.</span><span class="comparing" data-if="comparing">Showing the original picture.</span></div>
				</div>
				<div class="pv">
					<div class="pvcols">
						<div><div class="pvlab">Original</div><img class="pvimg" src="mevr:strip_original"/></div>
						<div><div class="pvlab">Adjusted</div><img class="pvimg" src="mevr:strip_adjusted"/></div>
					</div>
					<div class="pvnote">The grey steps should all stay distinct, the darkest from black and the brightest from white.</div>
				</div>
			</div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Image quality</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Render resolution</div><div class="rdesc">Now {{quality_text}} per eye · {{quality_note}}</div><div class="rdesc">{{headset_text}}</div></div>
				<div class="seg"><button class="segb disabled" data-if="!headset_known">Headset (unknown until VR starts)</button><button class="segb" data-if="headset_known" data-class-on="quality == 'headset'" data-event-click="pick('quality','headset')">Headset</button><button class="segb" data-if="headset_known" data-class-on="quality == 'headset85'" data-event-click="pick('quality','headset85')">Headset × 0.85</button><button class="segb" data-if="headset_known" data-class-on="quality == 'headset75'" data-event-click="pick('quality','headset75')">Headset × 0.75</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Fixed sizes</div><div class="rdesc">Halcyon's ladder, 2048 to 6144 wide: above your headset's size it supersamples</div></div>
				<div class="seg"><button class="segb" data-class-on="quality == 'low'" data-event-click="pick('quality','low')">Low</button><button class="segb" data-class-on="quality == 'performance'" data-event-click="pick('quality','performance')">Performance</button><button class="segb" data-class-on="quality == 'balanced'" data-event-click="pick('quality','balanced')">Balanced</button><button class="segb" data-class-on="quality == 'sharp'" data-event-click="pick('quality','sharp')">Sharp</button><button class="segb" data-class-on="quality == 'max'" data-event-click="pick('quality','max')">Max</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Upscale</div><div class="rdesc">Renders smaller and sharpens it back up: faster, a little softer. Pairs with Headset × 0.85.</div></div>
				<div class="seg"><button class="segb" data-class-on="upscale == 'off'" data-event-click="pick('upscale','off')">Off</button><button class="segb" data-class-on="upscale == 'fsr'" data-event-click="pick('upscale','fsr')">FSR</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Steady cutscenes</div><div class="rdesc">Caps cutscenes to a frame rate the headset can hold</div></div>
				<button class="tog" data-class-on="steady_cine" data-event-click="toggle('steady_cine')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Optional content</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Texture packs</div><div class="rdesc">Installed: {{content_installed}}</div><div class="note" data-if="content_msg != ''">{{content_msg}}</div></div>
				<button class="btn" data-event-click="cmd('content_request')"><div class="sweep"/><span>Install after I quit</span><div class="tick"/></button></div>
			<div class="hint">They change the game's files, so MEVR Setup adds them while the game is closed.</div>
		</div>
	</div>

	<!-- ===================================================================================== HUD -->
	<div data-if="section == 'hud'">
		<div class="stitle">HUD &amp; sights</div>
		<div class="sdesc">What's drawn over the world.</div>
		<div class="group">
			<div class="gtitle"><span>HUD</span><div class="gline"/></div>
			<div class="srow"><div class="slab">Distance</div><input type="range" min="1" max="3" step="0.1" data-value="hud_distance"/><div class="sval">{{hud_distance_text}}</div></div>
			<div class="srow"><div class="slab">Size</div><input type="range" min="70" max="140" step="5" data-value="hud_size"/><div class="sval">{{hud_size_text}}</div></div>
			<div class="row"><div class="rl"><div class="rlab">Hand reticle</div><div class="rdesc">A marker where the gun points, instead of the screen crosshair</div></div>
				<button class="tog" data-class-on="reticle" data-event-click="toggle('reticle')"><div class="knob"/></button></div>
		</div>
		<div class="group">
			<div class="gtitle"><span>Sights</span><div class="gline"/></div>
			<div class="row"><div class="rl"><div class="rlab">Pistol</div></div>
				<div class="seg"><button class="segb" data-class-on="sight_pistol == 'dot'" data-event-click="pick('sight_pistol','dot')">Red dot</button><button class="segb" data-class-on="sight_pistol == 'holo'" data-event-click="pick('sight_pistol','holo')">Holo</button><button class="segb" data-class-on="sight_pistol == 'none'" data-event-click="pick('sight_pistol','none')">None</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Shotgun and assault rifle</div></div>
				<div class="seg"><button class="segb" data-class-on="sight_rifle == 'dot'" data-event-click="pick('sight_rifle','dot')">Red dot</button><button class="segb" data-class-on="sight_rifle == 'holo'" data-event-click="pick('sight_rifle','holo')">Holo</button><button class="segb" data-class-on="sight_rifle == 'none'" data-event-click="pick('sight_rifle','none')">None</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Sniper rifle</div></div>
				<div class="seg"><button class="segb" data-class-on="sight_sniper == 'scope'" data-event-click="pick('sight_sniper','scope')">Scope 4×</button><button class="segb" data-class-on="sight_sniper == 'dot'" data-event-click="pick('sight_sniper','dot')">Red dot</button><button class="segb" data-class-on="sight_sniper == 'holo'" data-event-click="pick('sight_sniper','holo')">Holo</button><button class="segb" data-class-on="sight_sniper == 'none'" data-event-click="pick('sight_sniper','none')">None</button></div></div>
			<div class="row"><div class="rl"><div class="rlab">Sight alignment help</div><div class="rdesc">Raised to your eye, the gun eases the sight onto your line of view</div></div>
				<button class="tog" data-class-on="sight_assist" data-event-click="toggle('sight_assist')"><div class="knob"/></button></div>
			<div class="row"><div class="rl"><div class="rlab">Shots land on the dot</div><div class="rdesc">Each shot aims at whatever the sight line points at, near or far</div></div>
				<button class="tog" data-class-on="sight_converge" data-event-click="toggle('sight_converge')"><div class="knob"/></button></div>
		</div>
	</div>

	<!-- ===================================================================================== Advanced -->
	<div data-if="section == 'advanced'">
		<div class="stitle">Advanced</div>
		<div class="sdesc">The renderer's own settings, for fine-tuning and troubleshooting.</div>
		<div class="advwrap"><div class="seg advtabs">
			<button class="segb" data-class-on="advtab == 'tracking'" data-event-click="advtab = 'tracking'">Tracking</button>
			<button class="segb" data-class-on="advtab == 'fp'" data-event-click="advtab = 'fp'">First person</button>
			<button class="segb" data-class-on="advtab == 'view'" data-event-click="advtab = 'view'">View</button>
			<button class="segb" data-class-on="advtab == 'stereo'" data-event-click="advtab = 'stereo'">Stereo</button>
			<button class="segb" data-class-on="advtab == 'hud'" data-event-click="advtab = 'hud'">HUD placement</button>
			<button class="segb" data-class-on="advtab == 'profiles'" data-event-click="advtab = 'profiles'">Profiles</button>
			<button class="segb" data-class-on="advtab == 'diag'" data-event-click="advtab = 'diag'">Diagnostics</button>
		</div></div>

		<div data-if="advtab == 'tracking'">
			<div class="group">
				<div class="gtitle"><span>Head tracking</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Recenter key</div><div class="rdesc">{{recenter_key_desc}}</div></div>
					<button class="tog" data-class-on="recenter_key" data-event-click="toggle('recenter_key')"><div class="knob"/></button></div>
				<div class="srow"><div class="slab">Look speed</div><input type="range" min="0.25" max="2" step="0.05" data-value="look_speed"/><div class="sval">{{look_speed_text}}</div></div>
				<div class="srow"><div class="slab">Smoothing</div><input type="range" min="0" max="0.9" step="0.05" data-value="look_smooth"/><div class="sval">{{look_smooth_text}}</div></div>
			</div>
			<div class="group">
				<div class="gtitle"><span>Conversations, cutscenes and menus</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Conversations in VR</div><div class="rdesc">Off: shown on a flat screen in front of you</div></div>
					<button class="tog" data-class-on="vr_convo" data-event-click="toggle('vr_convo')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Cutscenes in VR</div><div class="rdesc">Off: shown on a flat screen in front of you</div></div>
					<button class="tog" data-class-on="vr_cine" data-event-click="toggle('vr_cine')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Flat game menus</div><div class="rdesc">The inventory and map on a flat screen, easier to read</div></div>
					<button class="tog" data-class-on="flat_menus" data-event-click="toggle('flat_menus')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Flat galaxy map</div><div class="rdesc">Off: the galaxy map in VR</div></div>
					<button class="tog" data-class-on="flat_galaxy" data-event-click="toggle('flat_galaxy')"><div class="knob"/></button></div>
			</div>
		</div>

		<div data-if="advtab == 'fp'">
			<div class="group">
				<div class="gtitle"><span>First-person camera</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">First person</div><div class="rdesc">Off: the game's own third-person camera (also: K)</div></div>
					<button class="tog" data-class-on="fp_on" data-event-click="toggle('fp_on')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Hide Shepard's head</div><div class="rdesc">Keeps hair and helmet out of your view</div></div>
					<button class="tog" data-class-on="fp_hide_head" data-event-click="toggle('fp_hide_head')"><div class="knob"/></button></div>
				<div class="srow"><div class="slab">Back</div><input type="range" min="-2" max="2" step="0.01" data-value="fp_back"/><div class="sval">{{fp_back_text}}</div></div>
				<div class="srow"><div class="slab">Right</div><input type="range" min="-1" max="1" step="0.01" data-value="fp_right"/><div class="sval">{{fp_right_text}}</div></div>
				<div class="srow"><div class="slab">Up</div><input type="range" min="-1" max="1" step="0.01" data-value="fp_up"/><div class="sval">{{fp_up_text}}</div></div>
				<div class="hint">Body &amp; calibration's "Line up with Shepard's head" sets these for you.</div>
			</div>
		</div>

		<div data-if="advtab == 'view'">
			<div class="group">
				<div class="gtitle"><span>Lean and view</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Lean</div><div class="rdesc">Leaning and stepping move the camera</div></div>
					<button class="tog" data-class-on="lean" data-event-click="toggle('lean')"><div class="knob"/></button></div>
				<div class="srow"><div class="slab">Lean gain</div><input type="range" min="0.5" max="3" step="0.1" data-value="lean_gain"/><div class="sval">{{lean_gain_text}}</div></div>
				<div class="srow"><div class="slab">Flat screen</div><input type="range" min="1" max="3.5" step="0.05" data-value="flat_size"/><div class="sval">{{flat_size_text}}</div></div>
				<div class="row"><div class="rl"><div class="rlab">Fill the field of view</div><div class="rdesc">Stretches the game's picture to the headset's full view</div></div>
					<button class="tog" data-class-on="fov_fill" data-event-click="toggle('fov_fill')"><div class="knob"/></button></div>
			</div>
		</div>

		<div data-if="advtab == 'stereo'">
			<div class="group">
				<div class="gtitle"><span>Stereo</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">VR mode</div><div class="rdesc">Stereo renders each eye; Depth builds the second eye from one render</div><div class="note" data-if="mode_note != ''">{{mode_note}}</div></div>
					<div class="seg"><button class="segb" data-class-on="vr_mode == 'mono'" data-event-click="pick('vr_mode','mono')">Mono</button><button class="segb" data-class-on="vr_mode == 'stereo'" data-event-click="pick('vr_mode','stereo')">Stereo</button><button class="segb" data-class-on="vr_mode == 'dibr'" data-event-click="pick('vr_mode','dibr')">Depth</button></div></div>
				<div class="row"><div class="rl"><div class="rlab">Life-size stereo</div><div class="rdesc">Each eye sees from where it really is, at the world's own scale: true depth and size</div></div>
					<button class="tog" data-class-on="life_size" data-event-click="toggle('life_size')"><div class="knob"/></button></div>
				<div data-if="life_size">
					<div class="srow"><div class="slab">Extra depth</div><input type="range" min="0.5" max="2" step="0.05" data-value="extra_depth"/><div class="sval">{{extra_depth_text}}</div></div>
					<div class="hint">1.00× is your own eye distance. More makes depth stronger and the world feel smaller.</div>
					<div class="row"><div class="rl"><div class="rlab">Each eye's own field of view</div><div class="rdesc">Renders each eye's real, off-centre view so the whole image is used. Off: one shared window for both eyes</div></div>
						<button class="tog" data-class-on="eye_frustum" data-event-click="toggle('eye_frustum')"><div class="knob"/></button></div>
				</div>
				<div data-if="!life_size">
					<div class="srow"><div class="slab">Eye distance</div><input type="range" min="0.5" max="8" step="0.1" data-value="eye_distance"/><div class="sval">{{eye_distance_text}}</div></div>
					<div class="srow"><div class="slab">Convergence</div><input type="range" min="-0.02" max="0.05" step="0.001" data-value="convergence"/><div class="sval">{{convergence_text}}</div></div>
					<div class="hint">Eye distance sets the world's scale: lower makes it feel bigger.</div>
					<div class="row"><div class="rl"><div class="rlab">Swap eyes</div><div class="rdesc">If depth looks inside out</div></div>
						<button class="tog" data-class-on="swap_eyes" data-event-click="toggle('swap_eyes')"><div class="knob"/></button></div>
				</div>
				<div class="row"><div class="rl"><div class="rlab">Quest field-of-view match</div><div class="rdesc">Matches the picture to a Quest's lenses over Link (no effect on SteamVR)</div></div>
					<button class="tog" data-class-on="quest_fov" data-event-click="toggle('quest_fov')"><div class="knob"/></button></div>
			</div>
			<div class="group">
				<div class="gtitle"><span>Graphics</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Depth of field</div><div class="rdesc">Turning it off sharpens the background but washes out colour (after a restart)</div></div>
					<button class="tog" data-class-on="dof" data-event-click="toggle('dof')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Desktop mirror</div><div class="rdesc">How often the monitor's picture updates, for recording; more costs frame rate</div></div>
					<div class="seg"><button class="segb" data-class-on="mirror == 'normal'" data-event-click="pick('mirror','normal')">Normal</button><button class="segb" data-class-on="mirror == 'smooth'" data-event-click="pick('mirror','smooth')">Every 2nd</button><button class="segb" data-class-on="mirror == 'every'" data-event-click="pick('mirror','every')">Every frame</button></div></div>
			</div>
		</div>

		<div data-if="advtab == 'hud'">
			<div class="group">
				<div class="gtitle"><span>HUD panel</span><div class="gline"/></div>
				<div class="srow"><div class="slab">Width</div><input type="range" min="0.6" max="2" step="0.05" data-value="panel_width"/><div class="sval">{{panel_width_text}}</div></div>
				<div class="srow"><div class="slab">Below eyes</div><input type="range" min="-0.3" max="0.6" step="0.01" data-value="panel_below"/><div class="sval">{{panel_below_text}}</div></div>
				<div class="srow"><div class="slab">Follow past</div><input type="range" min="0" max="120" step="5" data-value="panel_follow"/><div class="sval">{{panel_follow_text}}</div></div>
				<div class="row"><div class="rl"><div class="rlab">Put the panel where I'm looking</div></div>
					<button class="btn" data-event-click="cmd('place_hud')"><div class="sweep"/><div class="bi i-place"/><span>Place</span><div class="tick"/></button></div>
			</div>
			<div class="group">
				<div class="gtitle"><span>Game screens</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Combat HUD</div><div class="rdesc">Health, shields and squad status</div></div>
					<button class="tog" data-class-on="g_pchud" data-event-click="toggle('g_pchud')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Conversation wheel</div><div class="rdesc">The dialogue wheel and cutscene captions</div></div>
					<button class="tog" data-class-on="g_convo" data-event-click="toggle('g_convo')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Mission overlays</div><div class="rdesc">Boss bars, timers and mission prompts</div></div>
					<button class="tog" data-class-on="g_designer" data-event-click="toggle('g_designer')"><div class="knob"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Move and resize a screen</div><div class="rdesc">In the classic renderer menu's HUD tab, for now</div></div>
					<button class="btn" data-event-click="cmd('classic')"><div class="sweep"/><span>Edit</span><div class="tick"/></button></div>
			</div>
		</div>

		<div data-if="advtab == 'profiles'">
			<div class="group">
				<div class="gtitle"><span>Profiles</span><div class="gline"/></div>
				<div class="tiles">
					<div class="tile" data-class-active="prof_active == '0'"><div class="tl"><span data-if="prof_active == '0'">Active</span><span data-if="prof_active != '0'">Saved</span></div><div class="tv">{{prof0_name}}</div>
						<div class="tbtns"><button class="btn small" data-event-click="cmd('prof_load','0')"><div class="sweep"/><span>Load</span></button><button class="btn small" data-event-click="cmd('prof_save','0')"><div class="sweep"/><span>Save</span></button></div></div>
					<div class="tile" data-class-active="prof_active == '1'"><div class="tl"><span data-if="prof_active == '1'">Active</span><span data-if="prof_active != '1'">Saved</span></div><div class="tv">{{prof1_name}}</div>
						<div class="tbtns"><button class="btn small" data-event-click="cmd('prof_load','1')"><div class="sweep"/><span>Load</span></button><button class="btn small" data-event-click="cmd('prof_save','1')"><div class="sweep"/><span>Save</span></button></div></div>
				</div>
				<div class="tiles last">
					<div class="tile" data-class-active="prof_active == '2'"><div class="tl"><span data-if="prof_active == '2'">Active</span><span data-if="prof_active != '2'">Saved</span></div><div class="tv">{{prof2_name}}</div>
						<div class="tbtns"><button class="btn small" data-event-click="cmd('prof_load','2')"><div class="sweep"/><span>Load</span></button><button class="btn small" data-event-click="cmd('prof_save','2')"><div class="sweep"/><span>Save</span></button></div></div>
					<div class="tile" data-class-active="prof_active == '3'"><div class="tl"><span data-if="prof_active == '3'">Active</span><span data-if="prof_active != '3'">Saved</span></div><div class="tv">{{prof3_name}}</div>
						<div class="tbtns"><button class="btn small" data-event-click="cmd('prof_load','3')"><div class="sweep"/><span>Load</span></button><button class="btn small" data-event-click="cmd('prof_save','3')"><div class="sweep"/><span>Save</span></button></div></div>
				</div>
				<div class="note" data-if="prof_msg != ''">{{prof_msg}}</div>
				<div class="hint">A profile keeps every renderer setting on this page; your calibration and controls are kept separately. Changes here save into the active profile when the menu closes.</div>
			</div>
		</div>

		<div data-if="advtab == 'diag'">
			<div class="group">
				<div class="gtitle"><span>Diagnostics</span><div class="gline"/></div>
				<div class="row"><div class="rl"><div class="rlab">Snapshot</div><div class="rdesc">Closes the menu and saves what each eye sees, for a bug report (also: tap both stick clicks)</div></div>
					<button class="btn" data-event-click="cmd('snapshot')"><div class="sweep"/><div class="bi i-camera"/><span>Take</span><div class="tick"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Record a session</div><div class="rdesc">Your head and hand movements, to replay a problem</div></div>
					<button class="btn" data-event-click="cmd('record')"><div class="sweep"/><div class="bi i-record"/><span data-if="!recording">Record</span><span data-if="recording">Stop</span><div class="tick"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Measure frame timing</div><div class="rdesc">Closes the menu; where each frame's time goes, for 20 seconds</div><div class="note" data-if="perf_msg != ''">{{perf_msg}}</div></div>
					<button class="btn" data-event-click="cmd('perf')"><div class="sweep"/><div class="bi i-timer"/><span>Measure</span><div class="tick"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Reset renderer settings</div><div class="rdesc">Back to Halcyon's defaults for this session; your calibration, controls and head-aim choice are kept</div><div class="note" data-if="diag_msg != ''">{{diag_msg}}</div></div>
					<button class="btn danger" data-class-armed="reset_armed" data-event-click="cmd('reset')"><div class="sweep"/><div class="bi i-trash"/><span data-if="!reset_armed">Reset</span><span data-if="reset_armed">Confirm</span><div class="tick"/></button></div>
				<div class="row"><div class="rl"><div class="rlab">Classic renderer menu</div><div class="rdesc">{{classic_desc}}</div></div>
					<button class="btn" data-event-click="cmd('classic')"><div class="sweep"/><span>Open</span><div class="tick"/></button></div>
			</div>
		</div>
	</div>

	</div>
</div>

<div class="hints">
	<span><span class="key">Trigger</span>Select</span>
	<span><span class="key">Right stick</span>Scroll</span>
	<span><span class="key">B</span>Back</span>
	<span><span class="key">Hold both sticks</span>Close</span>
</div>

<div id="pointer"><div class="dot"/></div>
</body>
</rml>
