/* SPDX-License-Identifier: MIT */
/*
 * The omni-tool's rail (research/57) in ME1's own UI language, so it sits beside the game's screens as one of them (the owner,
 * 2026-11-04: "those left menu items don't really look like they are in mass-effect"). Read from the game's equipment screen:
 * octagonal panels with a slate-blue edge and a thin inner line over a dark navy gradient; slanted tabs, dark teal, the
 * selected one bright cyan with white text and a glow (its squad list); light-blue line icons in rounded squares (its weapon
 * tabs); pale cyan titles with a glow. The fallback uses drawn shapes. ME2 selects the Mission Computer palette,
 * and RailArt applies the same warm range to the cached art. Edit while the game runs: it reloads within a
 * second of a save (plugin/OmniToolRail). Decorators (plugin/menu/MenuDecorators): bevel(...), slant(...), chamfer(...), icon(...).
 */

body, div { display: block; }

body {
	--rail-label: #CBEBF5;
	--rail-art-label: #D2F1F8;
	--rail-title: #B9F3F6;
	--rail-glow: rgba(110,220,240,45%);
	--rail-ring: #C4F6FF;
	--rail-ring-fill: rgba(143,232,255,28%);
	width: 360dp;
	height: 640dp;  /* plugin/OmniToolRail's canvas, vr::omni_rail::kRailAspect */
	display: flex;
	flex-direction: column;
	justify-content: center;
	font-family: "Titillium Web";
	font-weight: 600;
	color: var(--rail-label);
	position: relative;
}

.panel {
	display: flex;
	flex-direction: column;
	gap: 8dp;
	padding: 26dp 18dp 28dp 18dp;
	decorator: bevel(30dp rgba(16,34,58,92%) rgba(8,17,32,92%) #4F82B2 2dp rgba(120,175,220,42%) 8dp);
}

.head {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-bottom: 6dp;
}
.kicker {
	font-family: Rajdhani;
	font-weight: 700;
	font-size: 32dp;
	letter-spacing: 0.08em;
	line-height: 34dp;
	color: var(--rail-title);
	font-effect: glow(1dp 5dp 0dp 0dp var(--rail-glow));
}
.sub { font-size: 19dp; line-height: 22dp; color: #7FA9BD; }
.rule {
	height: 2dp;
	margin: 10dp 10dp 4dp 10dp;
	background-color: rgba(120,175,220,38%);
}

.entry {
	height: 64dp;
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	gap: 16dp;
	padding: 0dp 22dp 0dp 26dp;
	font-size: 26dp;
	color: var(--rail-label);
	decorator: slant(16dp rgba(30,78,108,94%) rgba(17,46,72,94%) #5C93BE #2E5E86 2dp transparent 0dp);
}
.entry:hover {
	color: #EAFBFF;
	decorator: slant(16dp rgba(44,110,150,96%) rgba(24,66,100,96%) #92CCEC #3F7FAE 2dp rgba(110,200,240,25%) 6dp);
}
.entry:active {
	decorator: slant(16dp #4A9EC4 #22688E #D6F8FF #66B6DC 2dp rgba(130,220,250,40%) 8dp);
}
.entry.on {
	color: #FFFFFF;
	font-effect: glow(1dp 4dp 0dp 0dp rgba(200,245,255,55%));
	decorator: slant(16dp #6ACBE0 #2A8AAE #DDFBFF #86D6EC 2dp rgba(110,220,240,45%) 9dp);
}

/* The icon in its rounded square, as the game's weapon tabs. */
.box {
	width: 44dp;
	height: 44dp;
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	justify-content: center;
	decorator: chamfer(7dp rgba(10,32,52,85%) rgba(6,20,36,85%) rgba(126,190,230,75%) rgba(70,130,180,60%) 1.5dp);
}
.entry.on .box { decorator: chamfer(7dp rgba(255,255,255,22%) rgba(255,255,255,8%) #E8FDFF #BDEFFA 1.5dp); }
.ico { width: 28dp; height: 28dp; color: #8FD0EA; }
.entry:hover .ico { color: #BDEBFA; }
.entry.on .ico { color: #FFFFFF; }
.label { flex: 1 1 auto; }

.entry.close {
	height: 56dp;
	margin-top: 8dp;
	font-size: 25dp;
	color: #8FB9CC;
	decorator: slant(12dp rgba(12,28,48,90%) rgba(8,18,34,90%) #3A6690 #22466A 1.5dp transparent 0dp);
}
.entry.close:hover {
	color: #DDF5FF;
	decorator: slant(12dp rgba(28,64,96,94%) rgba(14,36,60,94%) #6FA8D0 #34668E 1.5dp transparent 0dp);
}
.entry.close .box { width: 40dp; height: 40dp; decorator: none; }
.entry.close .ico { width: 26dp; height: 26dp; color: #7FA9BD; }

.i-squad { decorator: icon(squad); }
.i-equipment { decorator: icon(equipment); }
.i-map { decorator: icon(map); }
.i-journal { decorator: icon(journal); }
.i-codex { decorator: icon(codex); }
.i-computer { decorator: icon(gamemenu); }
.i-close { decorator: icon(close); }

/* ---- The game's own art (plugin/RailArt, research/57): used once the mod has cached the game's movies; `art` on the body.
 * The frame is the inventory's item-list panel (its title notch takes the title), the buttons the journal's tab in its states
 * (normal, the game's orange mouse-on, selected), the type the game's own: Biomass for the title, Tigensu on the tabs. Sizes
 * match rail_art::Sizes (the textures are made at exactly these pixels). */
body.art .panel {
	position: relative;     /* the title's place is the frame's notch */
	box-sizing: border-box; /* the texture is exactly this size, padding included */
	width: 360dp;
	height: 640dp;
	gap: 10dp;
	padding: 62dp 20dp 48dp 40dp;
	decorator: image(mevr:me1-panel);
}
body.art .head {
	position: absolute;
	left: 66dp;    /* in the frame's title notch (panel x 51..252, y 3..33) */
	top: 5dp;
	padding: 0dp;
	align-items: flex-start;
}
body.art .kicker {
	font-family: "ME1 Biomass";
	font-weight: normal;
	font-size: 21dp;
	line-height: 26dp;
	letter-spacing: 0em;
	color: var(--rail-title);
	font-effect: glow(1dp 4dp 0dp 0dp rgba(110,220,240,40%));
}
body.art .sub, body.art .rule, body.art .box { display: none; }
body.art .entry, body.art .entry.close {
	box-sizing: border-box;
	width: 300dp;
	height: 64dp;
	margin-top: 0dp;
	padding: 0dp 0dp 0dp 52dp;
	font-family: "ME1 Tigensu";
	font-weight: normal;
	font-size: 28dp;
	letter-spacing: 0em;
	color: var(--rail-art-label);
	font-effect: none;
	decorator: image(mevr:me1-tab);
}
body.art .entry:hover { color: #FFF3DE; decorator: image(mevr:me1-tab-hover); }
body.art .entry.on { color: #FFFFFF; decorator: image(mevr:me1-tab-selected); }
body.art .entry.on:hover { decorator: image(mevr:me1-tab-selected-hover); }

/* The fingertip's ring (plugin/OmniToolRail): the depth cue, wide and faint far off, small and bright at the surface. */
.touchring {
	position: absolute;
	border: 3dp var(--rail-ring);
	border-radius: 999dp;
	background-color: var(--rail-ring-fill);
	pointer-events: none;
}

/* Mission Computer colors sampled from ME2. The cached frame and tabs take their palette in RailArt. */
@media (theme: mission-computer) {
	body {
		--rail-label: #FFDEAA;
		--rail-art-label: #FFE2AD;
		--rail-title: #FFD491;
		--rail-glow: rgba(255,159,63,45%);
		--rail-ring: #FFDC9A;
		--rail-ring-fill: rgba(255,169,69,28%);
	}
	body.art .kicker { font-effect: glow(1dp 4dp 0dp 0dp var(--rail-glow)); }
	.panel { decorator: bevel(30dp rgba(62,28,10,92%) rgba(34,14,5,92%) #B16A31 2dp rgba(255,153,74,42%) 8dp); }
	.sub { color: #E1B57C; }
	.rule { background-color: rgba(255,153,74,38%); }
	.entry { decorator: slant(16dp rgba(106,51,16,94%) rgba(58,24,8,94%) #D0651A #884516 2dp transparent 0dp); }
	.entry:hover {
		color: #FFF3DC;
		decorator: slant(16dp rgba(155,74,25,96%) rgba(100,43,13,96%) #F9BF74 #B76A33 2dp rgba(255,159,63,32%) 6dp);
	}
	.entry:active { decorator: slant(16dp #C86B26 #914415 #FFE5AB #D89044 2dp rgba(255,174,72,40%) 8dp); }
	.entry.on {
		font-effect: glow(1dp 4dp 0dp 0dp rgba(255,207,128,55%));
		decorator: slant(16dp #C87530 #9E4510 #FFE5AB #E4A050 2dp rgba(255,159,63,45%) 9dp);
	}
	.box { decorator: chamfer(7dp rgba(66,27,8,85%) rgba(42,15,4,85%) rgba(255,174,85,75%) rgba(188,102,38,60%) 1.5dp); }
	.entry.on .box { decorator: chamfer(7dp rgba(255,223,166,22%) rgba(255,223,166,8%) #FFE9B2 #FFD295 1.5dp); }
	.ico { color: #FFBF7D; }
	.entry:hover .ico { color: #FFE2AD; }
	.entry.close {
		color: #E1B57C;
		decorator: slant(12dp rgba(60,26,9,90%) rgba(34,14,5,90%) #9A5427 #6F3314 1.5dp transparent 0dp);
	}
	.entry.close:hover {
		color: #FFF3DC;
		decorator: slant(12dp rgba(117,53,17,94%) rgba(61,24,8,94%) #D69452 #A8531F 1.5dp transparent 0dp);
	}
	.entry.close .ico { color: #E1B57C; }
}

/* ME3's look (research/le3-native-gui.md "The rail in ME3's look"), sampled from ME3's own Mission Computer in the game (its
 * pause menu, Save 31, 2026-11-16): buttons a teal-blue gradient (#04567F into #04213C) with a bright cyan edge (#12A8D4,
 * #0591C5) and near-white type (#DEF5FE) over deep navy (#091024 into #040819); the selected entry deep red (#3E0516 into
 * #960C0D, its edge #B60504) with gold type (#FFCA65). ME3's frames and tabs are bitmap fills and its fonts a library the
 * game doesn't keep as an object, so the rail keeps its own shapes and fonts in these colours. */
@media (theme: me3) {
	body {
		--rail-label: #DEF5FE;
		--rail-art-label: #DEF5FE;
		--rail-title: #FFFFFF;
		--rail-glow: rgba(18,168,212,40%);
		--rail-ring: #9EE6FA;
		--rail-ring-fill: rgba(18,168,212,28%);
	}
	.panel { decorator: bevel(30dp rgba(9,16,36,94%) rgba(4,8,25,94%) #0591C5 2dp rgba(18,168,212,32%) 8dp); }
	.sub { color: #7FBFD8; }
	.rule { background-color: rgba(18,168,212,40%); }
	.entry { decorator: slant(16dp rgba(4,86,127,95%) rgba(4,33,60,95%) #12A8D4 #0591C5 2dp transparent 0dp); }
	.entry:hover {
		color: #FFFFFF;
		decorator: slant(16dp rgba(8,120,170,97%) rgba(5,52,90,97%) #7FE0FA #22B4E0 2dp rgba(18,168,212,35%) 6dp);
	}
	.entry:active { decorator: slant(16dp #0C8CC4 #05406E #C8F4FF #48C8EE 2dp rgba(60,200,240,40%) 8dp); }
	.entry.on {
		color: #FFCA65;
		font-effect: glow(1dp 4dp 0dp 0dp rgba(255,150,60,45%));
		decorator: slant(16dp #3E0516 #960C0D #E0140C #8A0409 2dp rgba(200,16,10,40%) 9dp);
	}
	.box { decorator: chamfer(7dp rgba(4,33,60,85%) rgba(4,8,25,85%) rgba(18,168,212,75%) rgba(5,145,197,60%) 1.5dp); }
	.entry.on .box { decorator: chamfer(7dp rgba(255,202,101,18%) rgba(255,202,101,6%) #FFCA65 #E89A3A 1.5dp); }
	.ico { color: #6FD2F2; }
	.entry:hover .ico { color: #DEF5FE; }
	.entry.on .ico { color: #FFCA65; }
	.entry.close {
		color: #7FBFD8;
		decorator: slant(12dp rgba(4,40,68,92%) rgba(4,14,32,92%) #0A7EAE #054A70 1.5dp transparent 0dp);
	}
	.entry.close:hover {
		color: #FFFFFF;
		decorator: slant(12dp rgba(8,100,150,94%) rgba(5,40,72,94%) #5CCDF2 #1A93C2 1.5dp transparent 0dp);
	}
	.entry.close .ico { color: #7FBFD8; }
}
