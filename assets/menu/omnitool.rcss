/*
 * The omni-tool's rail (research/56) in ME1's own UI language, so it sits beside the game's screens as one of them (the owner,
 * 2026-11-04: "those left menu items don't really look like they are in mass-effect"). Read from the game's equipment screen:
 * octagonal panels with a slate-blue edge and a thin inner line over a dark navy gradient; slanted tabs, dark teal, the
 * selected one bright cyan with white text and a glow (its squad list); light-blue line icons in rounded squares (its weapon
 * tabs); pale cyan titles with a glow. Our own shapes and colours: no game art. Edit while the game runs: it reloads within a
 * second of a save (plugin/OmniToolRail). Decorators (plugin/menu/MenuDecorators): bevel(...), slant(...), chamfer(...), icon(...).
 */

body, div { display: block; }

body {
	width: 360dp;
	height: 640dp;  /* plugin/OmniToolRail's canvas, vr::omni_rail::kRailAspect */
	display: flex;
	flex-direction: column;
	justify-content: center;
	font-family: "Titillium Web";
	font-weight: 600;
	color: #CBEBF5;
}

.panel {
	display: flex;
	flex-direction: column;
	gap: 8dp;
	padding: 26dp 18dp 28dp 18dp;
	decorator: bevel(30dp rgba(16,34,58,92%) rgba(8,17,32,92%) #4F82B2 2dp rgba(120,175,220,42%) 8dp);
}

.head {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding-bottom: 6dp;
}
.kicker {
	font-family: Rajdhani;
	font-weight: 700;
	font-size: 32dp;
	letter-spacing: 0.08em;
	line-height: 34dp;
	color: #B9F3F6;
	font-effect: glow(1dp 5dp 0dp 0dp rgba(110,220,240,45%));
}
.sub { font-size: 19dp; line-height: 22dp; color: #7FA9BD; }
.rule {
	height: 2dp;
	margin: 10dp 10dp 4dp 10dp;
	background-color: rgba(120,175,220,38%);
}

.entry {
	height: 64dp;
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	gap: 16dp;
	padding: 0dp 22dp 0dp 26dp;
	font-size: 26dp;
	color: #CBEBF5;
	decorator: slant(16dp rgba(30,78,108,94%) rgba(17,46,72,94%) #5C93BE #2E5E86 2dp transparent 0dp);
}
.entry:hover {
	color: #EAFBFF;
	decorator: slant(16dp rgba(44,110,150,96%) rgba(24,66,100,96%) #92CCEC #3F7FAE 2dp rgba(110,200,240,25%) 6dp);
}
.entry:active {
	decorator: slant(16dp #4A9EC4 #22688E #D6F8FF #66B6DC 2dp rgba(130,220,250,40%) 8dp);
}
.entry.on {
	color: #FFFFFF;
	font-effect: glow(1dp 4dp 0dp 0dp rgba(200,245,255,55%));
	decorator: slant(16dp #6ACBE0 #2A8AAE #DDFBFF #86D6EC 2dp rgba(110,220,240,45%) 9dp);
}

/* The icon in its rounded square, as the game's weapon tabs. */
.box {
	width: 44dp;
	height: 44dp;
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	justify-content: center;
	decorator: chamfer(7dp rgba(10,32,52,85%) rgba(6,20,36,85%) rgba(126,190,230,75%) rgba(70,130,180,60%) 1.5dp);
}
.entry.on .box { decorator: chamfer(7dp rgba(255,255,255,22%) rgba(255,255,255,8%) #E8FDFF #BDEFFA 1.5dp); }
.ico { width: 28dp; height: 28dp; color: #8FD0EA; }
.entry:hover .ico { color: #BDEBFA; }
.entry.on .ico { color: #FFFFFF; }
.label { flex: 1 1 auto; }

.entry.close {
	height: 56dp;
	margin-top: 8dp;
	font-size: 25dp;
	color: #8FB9CC;
	decorator: slant(12dp rgba(12,28,48,90%) rgba(8,18,34,90%) #3A6690 #22466A 1.5dp transparent 0dp);
}
.entry.close:hover {
	color: #DDF5FF;
	decorator: slant(12dp rgba(28,64,96,94%) rgba(14,36,60,94%) #6FA8D0 #34668E 1.5dp transparent 0dp);
}
.entry.close .box { width: 40dp; height: 40dp; decorator: none; }
.entry.close .ico { width: 26dp; height: 26dp; color: #7FA9BD; }

.i-squad { decorator: icon(squad); }
.i-equipment { decorator: icon(equipment); }
.i-map { decorator: icon(map); }
.i-journal { decorator: icon(journal); }
.i-codex { decorator: icon(codex); }
.i-computer { decorator: icon(gamemenu); }
.i-close { decorator: icon(close); }

/* ---- The game's own art (plugin/RailArt, research/56): used once the mod has cached the game's movies; `art` on the body.
 * The frame is the inventory's item-list panel (its title notch takes the title), the buttons the journal's tab in its states
 * (normal, the game's orange mouse-on, selected), the type the game's own: Biomass for the title, Tigensu on the tabs. Sizes
 * match rail_art::Sizes (the textures are made at exactly these pixels). */
body.art .panel {
	position: relative;     /* the title's place is the frame's notch */
	box-sizing: border-box; /* the texture is exactly this size, padding included */
	width: 360dp;
	height: 640dp;
	gap: 10dp;
	padding: 62dp 20dp 48dp 40dp;
	decorator: image(mevr:me1-panel);
}
body.art .head {
	position: absolute;
	left: 66dp;    /* in the frame's title notch (panel x 51..252, y 3..33) */
	top: 5dp;
	padding: 0dp;
	align-items: flex-start;
}
body.art .kicker {
	font-family: "ME1 Biomass";
	font-weight: normal;
	font-size: 21dp;
	line-height: 26dp;
	letter-spacing: 0em;
	color: #B9F3F6;
	font-effect: glow(1dp 4dp 0dp 0dp rgba(110,220,240,40%));
}
body.art .sub, body.art .rule, body.art .box { display: none; }
body.art .entry, body.art .entry.close {
	box-sizing: border-box;
	width: 300dp;
	height: 64dp;
	margin-top: 0dp;
	padding: 0dp 0dp 0dp 52dp;
	font-family: "ME1 Tigensu";
	font-weight: normal;
	font-size: 28dp;
	letter-spacing: 0em;
	color: #D2F1F8;
	font-effect: none;
	decorator: image(mevr:me1-tab);
}
body.art .entry:hover { color: #FFF3DE; decorator: image(mevr:me1-tab-hover); }
body.art .entry.on { color: #FFFFFF; decorator: image(mevr:me1-tab-selected); }
body.art .entry.on:hover { decorator: image(mevr:me1-tab-selected-hover); }
