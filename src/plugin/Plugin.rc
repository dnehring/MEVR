// SPDX-License-Identifier: MIT
// The ASI's version resource (LE1MEVR.asi, and LE2/LE3's): Windows' file properties, MEVR Setup and tools/package-release.ps1
// read it. The version is CMake's project(VERSION) (mevr/Version.hpp, generated); ProductVersion adds the build's commit
// (mevr/BuildInfo.hpp) as <version>+<commit>. The ASI as a whole is GPL-3.0 (it links Halcyon's renderer, NOTICE.md).
#include <winres.h>
#include "mevr/Version.hpp"
#include "mevr/BuildInfo.hpp"

#if defined(MEVR_GAME_LE1)
#define MEVR_RC_FILE "LE1MEVR.asi"
#define MEVR_RC_DESCRIPTION "MEVR: VR for Mass Effect (Legendary Edition)"
#elif defined(MEVR_GAME_LE2)
#define MEVR_RC_FILE "LE2MEVR.asi"
#define MEVR_RC_DESCRIPTION "MEVR: VR for Mass Effect 2 (Legendary Edition)"
#else
#define MEVR_RC_FILE "LE3MEVR.asi"
#define MEVR_RC_DESCRIPTION "MEVR: VR for Mass Effect 3 (Legendary Edition)"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MEVR_VERSION_RC
 PRODUCTVERSION MEVR_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MEVR"
            VALUE "FileDescription", MEVR_RC_DESCRIPTION
            VALUE "FileVersion", MEVR_VERSION
            VALUE "InternalName", MEVR_RC_FILE
            VALUE "LegalCopyright", "ME VR Attempt contributors, Halcyon and Aeka0; GPL-3.0, no warranty"
            VALUE "LegalTrademarks", "Fan project, not affiliated with EA or BioWare. Mass Effect is a trademark of EA International (Studio and Publishing) Ltd."
            VALUE "OriginalFilename", MEVR_RC_FILE
            VALUE "ProductName", "MEVR"
            VALUE "ProductVersion", MEVR_VERSION "+" MEVR_GIT_COMMIT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
