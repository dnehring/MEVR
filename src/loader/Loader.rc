// SPDX-License-Identifier: MIT
// The loader's version resource: the setup app tells our bink2w64.dll from RAD's and from ME3Tweaks' by its
// CompanyName and ProductName (install/Detect ClassifyBink: "MEVR" in the product name). The product name is the
// project's, the same in every signed binary (SignPath's rule, docs/code-signing.md); "MEVR ASI loader" until
// 2026-11-05, and the FileDescription still says so. The version is CMake's project(VERSION) (mevr/Version.hpp,
// generated); ProductVersion adds the build's commit (mevr/BuildInfo.hpp) as <version>+<commit>.
#include <winres.h>
#include "mevr/Version.hpp"
#include "mevr/BuildInfo.hpp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MEVR_VERSION_RC
 PRODUCTVERSION MEVR_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MEVR"
            VALUE "FileDescription", "MEVR ASI loader (bink2w64.dll proxy)"
            VALUE "FileVersion", MEVR_VERSION
            VALUE "InternalName", "bink2w64.dll"
            VALUE "LegalCopyright", "ME VR Attempt contributors, MIT; MinHook BSD-2-Clause"
            VALUE "OriginalFilename", "bink2w64.dll"
            VALUE "ProductName", "MEVR"
            VALUE "ProductVersion", MEVR_VERSION "+" MEVR_GIT_COMMIT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
