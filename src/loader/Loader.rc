// The loader's version resource: the setup app tells our bink2w64.dll from RAD's and from ME3Tweaks' by its
// CompanyName and ProductName (install/Detect ClassifyBink).
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MEVR"
            VALUE "FileDescription", "MEVR ASI loader (bink2w64.dll proxy)"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "bink2w64.dll"
            VALUE "LegalCopyright", "GPL-3.0-or-later; MinHook BSD-2-Clause"
            VALUE "OriginalFilename", "bink2w64.dll"
            VALUE "ProductName", "MEVR ASI loader"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
