// SPDX-License-Identifier: MIT
// ME3's Miranda (HMF_ARM_MIRa_MDL, her conversation outfit at her Citadel apartment): breast and glute bones for the jiggle
// stage (research/trilogy-jiggle.md). Placed from her mesh's own surface (tools/rig/README.md "Placing regions"): the front
// peaks at x 12.5 around z 132-138 cm, y +-4..8; the back at x -12.7 around z 92-98 cm. Mesh space: +X forward, +Y her
// right, +Z up, game units (cm). {LE3} is the game's ME3 BioGame folder, {MEVR} %LOCALAPPDATA%\MEVR.
{
  "source": "{LE3}/CookedPCConsole/BioD_CitHub_Miranda.pcc",
  "mesh": "HMF_ARM_MIRa_MDL",
  "out": "{MEVR}/rig/LE3/MEVR_Miranda.pcc",
  "name": "HMF_ARM_MIRa_MEVR",
  "bones": [
    { "name": "BreastLeft", "parent": "Chest2", "at": [5.5, -6.5, 133.0], "yaw": 0 },
    { "name": "BreastRight", "parent": "Chest2", "at": [5.5, 6.5, 133.0], "yaw": 0 },
    { "name": "GluteLeft", "parent": "Pelvis", "at": [-6.0, -7.0, 95.0], "yaw": 180 },
    { "name": "GluteRight", "parent": "Pelvis", "at": [-6.0, 7.0, 95.0], "yaw": 180 }
  ],
  "regions": [
    { "bone": "BreastLeft", "center": [9.0, -6.5, 133.5], "radius": [6.5, 7.5, 8.5], "weight": 0.9, "inner": 0.3, "from": ["Chest", "Chest1", "Chest2"] },
    { "bone": "BreastRight", "center": [9.0, 6.5, 133.5], "radius": [6.5, 7.5, 8.5], "weight": 0.9, "inner": 0.3, "from": ["Chest", "Chest1", "Chest2"] },
    { "bone": "GluteLeft", "center": [-9.0, -7.0, 94.0], "radius": [7.0, 8.0, 10.0], "weight": 0.85, "inner": 0.3, "from": ["Pelvis", "LowerBack", "Root"] },
    { "bone": "GluteRight", "center": [-9.0, 7.0, 94.0], "radius": [7.0, 8.0, 10.0], "weight": 0.85, "inner": 0.3, "from": ["Pelvis", "LowerBack", "Root"] }
  ]
}

