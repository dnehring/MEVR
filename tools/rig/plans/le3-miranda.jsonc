// SPDX-License-Identifier: MIT
// ME3's Miranda (tools/rig/README.md): her older rigged hair with hair chains, then her conversation outfit's body (her
// Citadel apartment) with the same chain bones (the hair stage simulates on the body she follows) and breast and glute
// bones for the jiggle (research/trilogy-jiggle.md). One package, MEVR_Miranda.pcc, built on the player's machine from
// their own game files. Mesh space: +X forward, +Y her right, +Z up, game units (cm); azimuth 0 front, 90 her right.
// {LE3} is the game's ME3 BioGame folder, {MEVR} %LOCALAPPDATA%\MEVR.
{
  "out": "{MEVR}/rig/LE3/MEVR_Miranda.pcc",
  "steps": [
    {
      "id": "hair",
      // Shoulder length: the crown at 181 cm, the tips at 142 (back) to 151 (sides); the face the open front between the
      // front locks (nothing below 167 there). The head's share of the shipped weights fades from 1 at 174 to 0 at 154.
      "source": "{LE3}/CookedPCConsole/BIOG_HMF_HIR_PRO.pcc",
      "mesh": "HMF_HIR_PROMiranda_MDL_Old",
      "name": "HMF_HIR_PROMiranda_MEVR",
      "hair": {
        "scalp": "Head",
        "prefix": "HairChain",
        "rootZ": 170,
        "blendAboveCm": 4,
        "joints": 4,
        "sectorWidthDeg": 40,
        "bandCm": 2,
        "sectors": [
          { "name": "Back", "az": 180 },
          { "name": "BackLeft", "az": -145 },
          { "name": "Left", "az": -105 },
          { "name": "FrontLeft", "az": -65 },
          { "name": "FrontRight", "az": 65 },
          { "name": "Right", "az": 105 },
          { "name": "BackRight", "az": 145 }
        ]
      }
    },
    {
      "id": "body",
      // Placed from her mesh's own surface (tools/rig/README.md "Placing regions"): the front peaks at x 12.5 around z
      // 132-138 cm, y +-4..8; the back at x -12.7 around z 92-98 cm.
      "source": "{LE3}/CookedPCConsole/BioD_CitHub_Miranda.pcc",
      "mesh": "HMF_ARM_MIRa_MDL",
      "name": "HMF_ARM_MIRa_MEVR",
      "bonesOf": ["hair"],
      "bones": [
        { "name": "BreastLeft", "parent": "Chest2", "at": [5.5, -6.5, 133.0], "yaw": 0 },
        { "name": "BreastRight", "parent": "Chest2", "at": [5.5, 6.5, 133.0], "yaw": 0 },
        { "name": "GluteLeft", "parent": "Pelvis", "at": [-6.0, -7.0, 95.0], "yaw": 180 },
        { "name": "GluteRight", "parent": "Pelvis", "at": [-6.0, 7.0, 95.0], "yaw": 180 }
      ],
      "regions": [
        { "bone": "BreastLeft", "center": [9.0, -6.5, 133.5], "radius": [6.5, 7.5, 8.5], "weight": 0.9, "inner": 0.3, "from": ["Chest", "Chest1", "Chest2"] },
        { "bone": "BreastRight", "center": [9.0, 6.5, 133.5], "radius": [6.5, 7.5, 8.5], "weight": 0.9, "inner": 0.3, "from": ["Chest", "Chest1", "Chest2"] },
        { "bone": "GluteLeft", "center": [-9.0, -7.0, 94.0], "radius": [7.0, 8.0, 10.0], "weight": 0.85, "inner": 0.3, "from": ["Pelvis", "LowerBack", "Root"] },
        { "bone": "GluteRight", "center": [-9.0, 7.0, 94.0], "radius": [7.0, 8.0, 10.0], "weight": 0.85, "inner": 0.3, "from": ["Pelvis", "LowerBack", "Root"] }
      ]
    }
  ]
}
