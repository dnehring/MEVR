// The fake MassEffect1.exe's version (tools/setup/FakeGame.cpp): the numbers the setup reads.
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,48602
 PRODUCTVERSION 2,0,0,48602
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MEVR test stand-in for MassEffect1.exe"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "ProductName", "MEVR fake game"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
