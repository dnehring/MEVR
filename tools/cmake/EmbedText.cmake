# Embeds a text file as a char array: cmake -DINPUT=<file> -DOUTPUT=<out.cpp> -DSYMBOL=<name> -P EmbedText.cmake
# writes `extern char const <name>[]` (the bytes, NUL-terminated) and `extern std::size_t const <name>Size` (the
# byte count without the terminator) in namespace mevr::embedded. For shader headers compiled at run time
# (external/fsr1), which MSVC's string literal limit (16 KB) keeps out of a plain literal.
if (NOT INPUT OR NOT OUTPUT OR NOT SYMBOL)
    message(FATAL_ERROR "EmbedText.cmake needs INPUT, OUTPUT and SYMBOL")
endif ()
file(READ "${INPUT}" content HEX)
string(LENGTH "${content}" hexLength)
math(EXPR byteCount "${hexLength} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arrayContent "${content}")
# One line per 32 bytes, so the file stays readable in an editor and compiles fast.
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" arrayContent "${arrayContent}")
get_filename_component(inputName "${INPUT}" NAME)
file(WRITE "${OUTPUT}"
    "// Generated by tools/cmake/EmbedText.cmake from ${inputName}; do not edit.\n"
    "#include <cstddef>\n"
    "namespace mevr::embedded {\n"
    "extern char const ${SYMBOL}[] = {\n${arrayContent}0x00};\n"
    "extern std::size_t const ${SYMBOL}Size = ${byteCount};\n"
    "}\n")
