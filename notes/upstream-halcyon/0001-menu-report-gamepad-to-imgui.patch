From f7b355a6c6396e7580400fc9ead46786f498dbd0 Mon Sep 17 00:00:00 2001
From: Daniel Nehring <17148851+dnehring@users.noreply.github.com>
Date: Thu, 8 Oct 2026 19:23:15 -0600
Subject: [PATCH] Halcyon menu: report a gamepad to ImGui, so pad navigation
 (Xbox and Touch) works at all

ImGui 1.92 clears every ImGuiKey_Gamepad_* each frame and keeps gamepad nav off unless the
backend sets ImGuiBackendFlags_HasGamepad. Upstream only set ConfigFlags_NavEnableGamepad, so
a94ea18's Touch merge reached ApplyGamepadInput and was then thrown away by NewFrame.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
SPDX-License-Identifier: GPL-3.0-only
 vr_menu.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/vr_menu.cpp b/src/vr_menu.cpp
index 3d6583b..67eba15 100644
--- a/src/vr_menu.cpp
+++ b/src/vr_menu.cpp
@@ -604,6 +604,10 @@ void ApplyGamepadInput() noexcept
     if (wheel != 0) io.AddMouseWheelEvent(0.0f, static_cast<float>(wheel) / static_cast<float>(WHEEL_DELTA));
 
     // ---- gamepad: read the REAL pad (bypasses the block) and feed ImGui gamepad-nav keys ----
+    // [MEVR] ImGui ignores every gamepad key unless the backend reports a gamepad: NewFrame clears
+    // all ImGuiKey_Gamepad_* state each frame without ImGuiBackendFlags_HasGamepad, and nav stays off.
+    // Upstream never set it, so pad navigation (Xbox or Touch) did nothing in this menu.
+    io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
     // Reads ONLY through g_origXInput (the trampoline set by InstallInputBlock) - the clean project
     // doesn't link the static xinput import, so there's no direct-call fallback. Neutral until installed.
     XINPUT_STATE xs = {};
-- 
