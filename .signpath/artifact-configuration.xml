<!--
  SignPath's artifact configuration for MEVR's releases (docs/code-signing.md). SignPath keeps its own copy: paste this
  into the project's artifact configuration there; this file is the reviewed source of it.

  The artifact is the zip .github/workflows/release.yml uploads: MEVR-Setup.exe, bink2w64.dll, and LE1MEVR.asi under the
  name LE1MEVR.asi.dll (SignPath's list of PE extensions has no .asi; the workflow renames it back after signing).
  Every file must say product name "MEVR" and the ProductVersion the workflow passes in ("version": <version>+<commit>,
  the binaries' own, from CMake's project(VERSION) and the build's commit).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="MEVR" product-version="${version}">
      <include path="MEVR-Setup.exe" />
      <include path="bink2w64.dll" />
      <include path="LE1MEVR.asi.dll" />
      <for-each>
        <authenticode-sign description="MEVR: VR for Mass Effect Legendary Edition" description-url="https://github.com/dnehring/MEVR" />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
